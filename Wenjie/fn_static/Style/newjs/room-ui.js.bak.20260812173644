/**
 * 房间页公共 UI：侧栏、直播、本地倒计时、首屏消息渲染
 * 背景音乐开关见 /Style/newjs/bg-music.js（#Jaudio / bgMusic.mp3）
 */
(function (window, document) {
  // App WebView 常无 safe-area：探测后写入 CSS 变量，顶栏下移避开状态栏
  try {
    var root = document.documentElement;
    var probe = document.createElement('div');
    probe.style.cssText = 'position:fixed;top:0;left:0;height:env(safe-area-inset-top);width:0;visibility:hidden;pointer-events:none;';
    root.appendChild(probe);
    var inset = probe.getBoundingClientRect().height || 0;
    probe.parentNode && probe.parentNode.removeChild(probe);
    if (inset < 1) {
      inset = Math.round((window.devicePixelRatio > 2 ? 40 : 28));
    }
    root.style.setProperty('--fn-status-bar', inset + 'px');
  } catch (e) {}

  function qs(sel, root) { return (root || document).querySelector(sel); }

  // 自绘下注键盘必须独占触摸手势，避免 WebView 滚动/合成 click 改变命中位置。
  function isRoomKeyboardTarget(target) {
    return !!(target && target.closest && target.closest('.keybaord,.numbaord,.fast-keyboard,.pc28-numboard,.pc28-quick-btn,.pc28-quick-line'));
  }
  document.addEventListener('touchstart', function (event) {
    if (isRoomKeyboardTarget(event.target)) event.preventDefault();
  }, { capture: true, passive: false });
  document.addEventListener('touchmove', function (event) {
    if (isRoomKeyboardTarget(event.target)) event.preventDefault();
  }, { capture: true, passive: false });

  window.__roomLeftSec = 0;
  window.__roomFpSec = 1;
  window.__roomTickStarted = false;
  window.__roomDeadlineMs = 0;
  window.__roomNextSn = '';
  window.__roomWaitingDraw = false;
  window.__roomSealed = false;
  window.__roomServerSealed = false;
  window.__roomSealSec = 0;
  window.__roomUpstreamBadSince = 0;

  // 上游缺期/安全熔断时，页面必须明确提示维护，不能伪装成普通“开奖中”。
  // 对没有返回 stale_gap、但长期停在 publishing/closed 的直播游戏也做超时识别。
  window.updateUpstreamMaintenance = function (row) {
    var market = String(row && row.market_state || '').toLowerCase();
    var phase = String(row && row.live_phase || '').toLowerCase();
    var reason = String(row && row.phase_reason || '').toLowerCase();
    var directStale = parseInt(row && row.upstream_maintenance, 10) === 1
      || market === 'stale_gap'
      || /stale_gap|upstream_stale|circuit_breaker|missing_issue|source_gap/.test(reason);
    var waitingDraw = parseInt(row && row.waiting_draw, 10) === 1
      || String(row && row.draw_status || '') === 'drawing'
      || String(row && row.draw_status || '') === 'processing';
    var noNextClock = !parseInt(row && row.next_at_ms, 10)
      && !parseInt(row && row.effective_next_at_ms, 10);
    // PK10 等直播房间在开奖等待阶段可能清空 live_phase/market_state，
    // 但仍会保留 waiting_draw/draw_status 和无下一期绝对时间。
    var liveFallback = [5, 6, 7, 10].indexOf(parseInt(window.ROOM_GAME_ID, 10)) >= 0
      && waitingDraw
      && noNextClock
      && (market === '' || market === 'closed' || market === 'pending');
    var waitingPublishing = (phase === 'publishing'
      && (market === 'closed' || market === 'pending')
      && waitingDraw) || liveFallback;
    var now = Date.now();
    if (waitingPublishing) {
      if (!window.__roomUpstreamBadSince) window.__roomUpstreamBadSince = now;
    } else {
      window.__roomUpstreamBadSince = 0;
    }
    var stale = directStale
      || (waitingPublishing && window.__roomUpstreamBadSince > 0
        && now - window.__roomUpstreamBadSince >= 90000);
    // 不再使用整页覆盖层，只切换顶部倒计时位置的文案。
    window.__roomUpstreamMaintenance = !!stale;
    var el = document.getElementById('upstreamMaintenanceMask');
    if (el && el.parentNode) el.parentNode.removeChild(el);
  };

  /** 封盘/开奖中禁止下注（上下分、取消、充值指引放行） */
  window.roomGuardSendBet = function (content) {
    var c = String(content == null ? '' : content).replace(/^\s+|\s+$/g, '');
    if (!c) return true;
    if (c === '取消' || c === '充值指引') return true;
    if (/^(上分|下分|上|下|查|回)\d+/.test(c)) return true;
    // 发送进行中不因本地倒计时跳变再拦（避免点下去后瞬间封盘提示）
    if (window.__sendBusy) return true;
    if (window.__roomWaitingDraw || window.__roomSealed) {
      if (typeof jqtoast === 'function') jqtoast('封盘禁止下注');
      return false;
    }
    // letf_time 已是「直播对齐 − 封盘秒」，>0 才可下注
    if (localLeftSec() > 0) return true;
    if (typeof jqtoast === 'function') jqtoast('封盘禁止下注');
    return false;
  };

  window.__roomLivePlayer = null;

  function liveGuideSkipKey() {
    var d = new Date();
    var m = d.getMonth() + 1;
    var day = d.getDate();
    return 'fn_live_guide_skip_' + d.getFullYear() + (m < 10 ? '0' : '') + m + (day < 10 ? '0' : '') + day;
  }

  function isLiveGuideSkippedToday() {
    try {
      return localStorage.getItem(liveGuideSkipKey()) === '1';
    } catch (e) {
      return false;
    }
  }

  function markLiveGuideSkipToday() {
    try { localStorage.setItem(liveGuideSkipKey(), '1'); } catch (e) {}
  }

  function hideLiveEntryGuide(immediate) {
    var el = qs('#roomLiveGuide');
    if (!el) return;
    clearTimeout(window.__roomLiveGuideTimer);
    var finish = function () {
      if (!el) return;
      el.classList.remove('is-on', 'is-leaving');
      // 必须移出 DOM：仅 display:none 时部分 WebView 仍会挡点击
      if (el.parentNode) {
        try { el.parentNode.removeChild(el); } catch (e) {}
      }
    };
    if (immediate) {
      finish();
      return;
    }
    el.classList.add('is-leaving');
    window.__roomLiveGuideTimer = setTimeout(finish, 480);
  }

  function buildLiveGuideHtml() {
    return ''
      + '<div class="room-live-guide-mask" aria-hidden="true"></div>'
      + '<div class="room-live-guide-panel">'
      +   '<img class="room-live-guide-tip" src="/Style/newimg/guide/live_guide_tip.webp?v=20260730g1" alt="点击右侧【直播】竞猜更精彩" draggable="false"'
      +        ' onerror="this.onerror=null;this.src=\'/Style/newimg/guide/live_guide_tip.png?v=20260730g1\'">'
      +   '<label class="room-live-guide-today">'
      +     '<input type="checkbox" id="roomLiveGuideToday">'
      +     '<span>今日不再提示</span>'
      +   '</label>'
      +   '<button type="button" class="room-live-guide-ok" id="roomLiveGuideOk" aria-label="知道了">'
      +     '<img src="/Style/newimg/guide/live_guide_ok.webp?v=20260730g1" alt="知道了"'
      +          ' onerror="this.onerror=null;this.src=\'/Style/newimg/guide/live_guide_ok.png?v=20260730g1\'" draggable="false">'
      +   '</button>'
      + '</div>';
  }

  /** 仅有直播按钮的房间：灰色蒙版引导；支持「今日不再提示」 */
  function showLiveEntryGuide() {
    var hasLiveBtn = !!qs('.fab-btn.is-live');
    if (!hasLiveBtn) {
      var junk = qs('#roomLiveGuide');
      if (junk && junk.parentNode) junk.parentNode.removeChild(junk);
      return;
    }
    if (isLiveGuideSkippedToday()) {
      var skipEl = qs('#roomLiveGuide');
      if (skipEl && skipEl.parentNode) skipEl.parentNode.removeChild(skipEl);
      return;
    }
    if (window.__roomLiveGuideStarted) return;
    window.__roomLiveGuideStarted = true;

    var el = qs('#roomLiveGuide');
    if (!el) {
      el = document.createElement('div');
      el.id = 'roomLiveGuide';
      el.className = 'room-live-guide';
      el.setAttribute('role', 'dialog');
      el.setAttribute('aria-label', '直播提示');
      el.innerHTML = buildLiveGuideHtml();
      document.body.appendChild(el);
    } else if (!el.querySelector('.room-live-guide-panel')) {
      el.innerHTML = buildLiveGuideHtml();
    }

    if (!el.__liveGuideBound) {
      el.__liveGuideBound = true;
      el.addEventListener('click', function (e) {
        // 点蒙版空白不关；必须点「知道了」
        e.stopPropagation();
      }, false);
      var ok = el.querySelector('#roomLiveGuideOk') || el.querySelector('.room-live-guide-ok');
      if (ok) {
        ok.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var cb = el.querySelector('#roomLiveGuideToday');
          if (cb && cb.checked) markLiveGuideSkipToday();
          hideLiveEntryGuide(false);
        }, false);
      }
    }

    el.style.display = '';
    el.style.opacity = '';
    el.style.animation = '';
    el.classList.remove('is-leaving');
    void el.offsetWidth;
    el.classList.add('is-on');
  }
  window.showLiveEntryGuide = showLiveEntryGuide;
  window.hideLiveEntryGuide = hideLiveEntryGuide;

  window.toggleRoomLive = function (e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    hideLiveEntryGuide(true);
    var panel = qs('#roomLivePanel');
    if (!panel) return false;
    var opening = !panel.classList.contains('is-open');
    panel.classList.toggle('is-open', opening);
    var frame = panel.querySelector('iframe');
    if (frame) {
      if (opening) {
        // iframe 在进房时已预加载；首击只显示现成播放器，不能在点击时才设置 src。
        try { frame.contentWindow.postMessage({ type: 'feiniao_live_resume' }, '*'); } catch (err) {}
      } else {
        // 保留已加载的原生播放器，关闭时暂停，重新打开时无需第二次加载。
        try { frame.contentWindow.postMessage({ type: 'feiniao_live_pause' }, '*'); } catch (err) {}
      }
    }
    // 顶栏高度变化后同步聊天区留白
    setTimeout(syncRoomHeadSpace, 30);
    setTimeout(syncRoomHeadSpace, 320);
    return false;
  };

  /** 按固定顶栏实际高度撑开聊天区，避免直播挡住开奖结果栏或盖住消息 */
  function syncRoomHeadSpace() {
    var head = qs('.room-fixed-head');
    var chat = qs('.chat-content.has-room-head');
    if (!head || !chat) return;
    var h = Math.ceil(head.getBoundingClientRect().height || 0);
    if (h < 10) return;
    chat.style.paddingTop = h + 'px';
  }
  window.syncRoomHeadSpace = syncRoomHeadSpace;

  window.toggleRoomGameSwitch = function (e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    var panel = qs('#roomGameSwitch');
    if (!panel) return false;
    panel.classList.toggle('is-open');
    return false;
  };

  document.addEventListener('click', function () {
    var sw = qs('#roomGameSwitch');
    if (sw) sw.classList.remove('is-open');
  }, false);

  function localLeftSec() {
    if (window.__roomDeadlineMs > 0) {
      return Math.max(0, Math.ceil((window.__roomDeadlineMs - Date.now()) / 1000));
    }
    return Math.max(0, parseInt(window.__roomLeftSec, 10) || 0);
  }

  function paintLeftTime() {
    if (typeof window.buildTime !== 'function') return;
    var el = document.getElementById('left_time');
    if (!el) return;
    var left = localLeftSec();
    var sealSec = Math.max(0, parseInt(window.__roomSealSec, 10) || 0);
    window.__roomLeftSec = left;

    // 时钟已是「直播 − 封盘」：归零 → 封盘中；开奖中只听服务端
    if (!window.__roomWaitingDraw) {
      if (left <= 0 && (window.__roomDeadlineMs > 0 || sealSec > 0 || window.__roomServerSealed)) {
        window.__roomSealed = true;
        window.__roomLeftSec = 0;
        window.__roomDeadlineMs = 0;
        window.__roomPhaseRank = Math.max(1, parseInt(window.__roomPhaseRank, 10) || 0);
      } else if (left > 0) {
        window.__roomSealed = !!window.__roomServerSealed;
      }
    }
    if (window.__roomWaitingDraw) {
      window.__roomSealed = false;
      window.__roomLeftSec = 0;
      window.__roomDeadlineMs = 0;
    } else if (window.__roomSealed) {
      window.__roomLeftSec = 0;
      window.__roomDeadlineMs = 0;
    }
    el.innerHTML = window.buildTime(window.__roomLeftSec, window.__roomFpSec);
  }

  /**
   * 倒计时同步（减法）：
   * open → 跟 bet_close_at（有效开奖点 − 封盘秒）；直播 78、封盘 30 → 顶栏约 48；
   * sealed → 封盘中；drawing → 开奖中。
   */
  function applyOpenCountdown(row) {
    if (!row || row.letf_time == null || row.letf_time === '') return;
    if (!row.__req_sent_ms && window.__roomLastPollSentMs) {
      row.__req_sent_ms = window.__roomLastPollSentMs;
    }
    var serverLeft = parseInt(row.letf_time, 10);
    if (isNaN(serverLeft)) return;
    if (serverLeft < 0) serverLeft = 0;
    var serverFp = parseInt(row.fp_time, 10);
    if (isNaN(serverFp) || serverFp < 1) serverFp = 1;
    var serverSeal = parseInt(row.seal_seconds, 10);
    if (!isNaN(serverSeal) && serverSeal >= 0) {
      window.__roomSealSec = serverSeal;
    }
    var nextSn = String(row.next_sn || '');
    var status = String(row.draw_status || '');
    // 直播周期只接受服务端的三态结果。旧版下面的“聊天/播放器/本地阶段棘轮”
    // 会把已进入 drawing 的同一期又复活成 open，或把后台 fengtime 加回秒表。
    var directCloseMs = row && row.bet_close_at_ms != null ? parseInt(row.bet_close_at_ms, 10) : 0;
    if (status === 'open' && directCloseMs > 0) {
      var directServerMs = row && row.server_now_ms != null ? parseInt(row.server_now_ms, 10) : 0;
      var directDeadline = directServerMs > 0 ? directCloseMs + (Date.now() - directServerMs) : directCloseMs;
      var directTermChanged = !!(nextSn && nextSn !== window.__roomNextSn);
      if (!directTermChanged && window.__roomDeadlineMs > 0) {
        directDeadline = window.__roomDeadlineMs;
      }
      window.__roomWaitingDraw = false;
      window.__roomSealed = false;
      window.__roomServerSealed = false;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      window.__roomDeadlineMs = directDeadline;
      window.__roomLeftSec = Math.max(0, Math.ceil((directDeadline - Date.now()) / 1000));
      window.__roomFpSec = serverFp;
      window.__roomPhaseRank = 0;
      row.letf_time = window.__roomLeftSec;
      row.fp_time = serverFp;
      return;
    }
    if (status === 'sealed') {
      window.__roomWaitingDraw = false;
      window.__roomSealed = true;
      window.__roomServerSealed = true;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      window.__roomDeadlineMs = 0;
      window.__roomLeftSec = 0;
      window.__roomFpSec = serverFp;
      window.__roomPhaseRank = 1;
      row.letf_time = 0;
      row.fp_time = serverFp;
      return;
    }
    if (status === 'drawing' || status === 'processing' || parseInt(row.waiting_draw, 10) === 1) {
      window.__roomWaitingDraw = true;
      window.__roomSealed = false;
      window.__roomServerSealed = false;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      window.__roomDeadlineMs = 0;
      window.__roomLeftSec = 0;
      window.__roomFpSec = serverFp;
      window.__roomPhaseRank = 2;
      row.letf_time = 0;
      row.fp_time = serverFp;
      return;
    }
    var wasWaiting = !!window.__roomWaitingDraw;
    var wasSealed = !!window.__roomSealed;
    var sealSec = Math.max(0, parseInt(window.__roomSealSec, 10) || 0);
    // letf_time 已减封盘：sealed 只看服务端状态
    var nowSealed = status === 'sealed';
    window.__roomServerSealed = nowSealed;
    var nowWaiting = status === 'processing'
      || status === 'drawing'
      || status === 'waiting_live_open'
      || parseInt(row.waiting_draw, 10) === 1;
    function normTerm(v) {
      var s = String(v == null ? '' : v).replace(/^0+/, '');
      return s || '0';
    }
    var chatTerm = window.__roomChatOpenTerm ? normTerm(window.__roomChatOpenTerm) : '';
    var nextNorm = nextSn ? normTerm(nextSn) : '';
    var phaseReason = String(row.phase_reason || '');
    var holdLocked = phaseReason === 'live_holding'
      || phaseReason === 'processing'
      || phaseReason === 'waiting_live_open'
      || (phaseReason.indexOf('wait_live_') === 0 && status !== 'open')
      || status === 'waiting_live_open';
    // ★ 顶栏只认 bet_close（已减封盘秒），绝不能用 effective_next（会把封盘加回去）
    var betCloseRaw = row && row.bet_close_at_ms != null ? parseInt(row.bet_close_at_ms, 10) : 0;
    if ((status !== 'open' || !(betCloseRaw > 0)) && (nowWaiting || nowSealed || holdLocked || serverLeft <= 0)) {
      if (status !== 'open' || nowWaiting || holdLocked) {
        window.__roomDeadlineMs = 0;
      }
    }
    if (serverLeft > 0 && status === 'open' && betCloseRaw > 0 && !holdLocked) {
      holdLocked = false;
      nowWaiting = false;
      nowSealed = false;
      if (nextNorm) {
        window.__roomOpenedTerm = nextNorm;
        window.__roomOpenedCloseMs = betCloseRaw;
      }
    } else if (status !== 'open' || !(betCloseRaw > 0)) {
      // 服务端状态是唯一裁决。旧逻辑会在本地记录的旧 deadline 尚未到时，
      // 把 drawing / waiting_live_open 强行复活成 open，造成提前开盘、秒数跳快。
      if (holdLocked || nowWaiting || status === 'drawing' || status === 'processing' || status === 'waiting_live_open') {
        serverLeft = 0;
        row.letf_time = 0;
      }
    }
    if (chatTerm && nextNorm && chatTerm === nextNorm && !holdLocked && betCloseRaw > 0) {
      if (nowWaiting && (status === 'open' || status === 'sealed' || serverLeft > 0)) {
        nowWaiting = false;
        row.waiting_draw = 0;
      }
      if (serverLeft > 0 && status === 'open') {
        nowWaiting = false;
        nowSealed = false;
        row.waiting_draw = 0;
        row.draw_status = 'open';
        status = 'open';
      }
    }
    // 直播 hold：强制开奖中，不允许本地倒计时抢跑
    if (holdLocked || (status === 'drawing' && phaseReason === 'live_holding')) {
      nowWaiting = true;
      nowSealed = false;
      serverLeft = 0;
      row.letf_time = 0;
      row.waiting_draw = 1;
      row.next_at = 0;
      window.__roomDeadlineMs = 0;
    }
    if (!holdLocked && nowWaiting && chatTerm && nextNorm && chatTerm !== nextNorm && betCloseRaw > 0) {
      var chatNum = parseInt(chatTerm, 10) || 0;
      var nextNum = parseInt(nextNorm, 10) || 0;
      if (chatNum > nextNum) {
        nowWaiting = false;
        row.next_sn = String(row.next_sn || chatTerm);
        if (serverLeft > 0 && status === 'open') {
          nowSealed = false;
          row.waiting_draw = 0;
          row.draw_status = 'open';
          status = 'open';
        } else if (status === 'sealed') {
          nowSealed = true;
          row.draw_status = 'sealed';
          row.waiting_draw = 0;
          serverLeft = 0;
          row.letf_time = 0;
        }
      }
    }
    if (!holdLocked && nowWaiting && serverLeft > 0 && status === 'open' && betCloseRaw > 0) {
      nowWaiting = false;
    }
    if (nowSealed && status === 'sealed') {
      nowWaiting = false;
      if (nextNorm && window.__roomOpenedTerm && normTerm(window.__roomOpenedTerm) === nextNorm) {
        window.__roomOpenedCloseMs = 0;
      }
    }
    if (!holdLocked && status === 'open' && serverLeft > 0 && betCloseRaw > 0) {
      nowWaiting = false;
      nowSealed = false;
    }

    function phaseRank(sealed, waiting) {
      if (waiting) return 2;
      if (sealed) return 1;
      return 0;
    }
    var phaseSn = nextNorm || nextSn || '';
    if (phaseSn && window.__roomPhaseSn && window.__roomPhaseSn !== phaseSn) {
      window.__roomPhaseSn = phaseSn;
      window.__roomPhaseRank = 0;
    } else if (phaseSn && !window.__roomPhaseSn) {
      window.__roomPhaseSn = phaseSn;
      window.__roomPhaseRank = phaseRank(wasSealed, wasWaiting);
    }
    var curRank = typeof window.__roomPhaseRank === 'number'
      ? window.__roomPhaseRank
      : phaseRank(wasSealed, wasWaiting);
    var newRank = phaseRank(nowSealed, nowWaiting);
    if (status === 'open' && serverLeft > 0 && betCloseRaw > 0 && !holdLocked) {
      curRank = 0;
      window.__roomPhaseRank = 0;
      newRank = 0;
      nowWaiting = false;
      nowSealed = false;
      window.__roomWaitingDraw = false;
    } else if (nowSealed) {
      nowWaiting = false;
      window.__roomWaitingDraw = false;
      curRank = 1;
      window.__roomPhaseRank = 1;
      newRank = 1;
    } else if (phaseSn && newRank < curRank) {
      if (curRank >= 2) {
        nowWaiting = true;
        nowSealed = false;
        serverLeft = 0;
      } else if (curRank >= 1) {
        nowWaiting = false;
        nowSealed = true;
        serverLeft = 0;
      }
      newRank = curRank;
    } else if (phaseSn && newRank > curRank) {
      window.__roomPhaseRank = newRank;
    } else if (phaseSn) {
      window.__roomPhaseRank = Math.max(curRank, newRank);
    }

    var localLeft = localLeftSec();
    var termChanged = !!(nextSn && nextSn !== window.__roomNextSn);
    var diff = Math.abs(serverLeft - localLeft);

    function deadlineFromRow(leftSec, row) {
      // ★ 只认 bet_close_at_ms（已减封盘）。用 effective_next 会把 30 秒加回去 → 直播78顶栏107
      var nextMs = row && row.bet_close_at_ms != null ? parseInt(row.bet_close_at_ms, 10) : 0;
      if (!(nextMs > 0)) {
        if (leftSec > 0 && String(row && row.draw_status || '') === 'open') {
          return Date.now() + leftSec * 1000;
        }
        return 0;
      }
      var serverNow = row && row.server_now_ms != null ? parseInt(row.server_now_ms, 10) : 0;
      var sentAt = (row && row.__req_sent_ms) || window.__roomLastPollSentMs || 0;
      var recvAt = Date.now();
      if (nextMs > 0 && serverNow > 0) {
        var skew;
        if (sentAt > 0 && recvAt >= sentAt) {
          var rtt = recvAt - sentAt;
          skew = (sentAt + rtt / 2) - serverNow;
        } else {
          skew = recvAt - serverNow;
        }
        if (typeof window.__roomSkewMs !== 'number') {
          window.__roomSkewMs = skew;
        } else {
          window.__roomSkewMs = window.__roomSkewMs * 0.7 + skew * 0.3;
        }
        return nextMs + window.__roomSkewMs;
      }
      if (nextMs > 0) return nextMs;
      if (leftSec > 0) return Date.now() + leftSec * 1000;
      return 0;
    }

    var hasBetClose = betCloseRaw > 0;
    if (!hasBetClose && !wasWaiting && status === 'open' && localLeft > 0 && serverLeft > localLeft + 2) {
      serverLeft = localLeft;
    }

    function lockDeadlineMs(candidateMs, termKey, sealSecVal) {
      var c = parseInt(candidateMs, 10) || 0;
      if (!(c > 0)) return 0;
      var key = String(termKey || '');
      var seal = parseInt(sealSecVal, 10);
      if (isNaN(seal) || seal < 0) seal = 0;
      window.__roomLockDeadlineMs = c;
      window.__roomLockSeal = seal;
      if (key) window.__roomLockTerm = key;
      return c;
    }
    function clearDeadlineLock() {
      window.__roomLockDeadlineMs = 0;
      window.__roomLockTerm = '';
      window.__roomLockSeal = undefined;
    }

    if (nowWaiting && !nowSealed) {
      window.__roomWaitingDraw = true;
      window.__roomSealed = false;
      window.__roomLeftSec = 0;
      window.__roomFpSec = serverFp;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      window.__roomDeadlineMs = 0;
      clearDeadlineLock();
      row.letf_time = 0;
      row.fp_time = window.__roomFpSec;
      return;
    }

    if ((wasWaiting && !nowWaiting) || (wasSealed && !nowSealed && serverLeft > 0)) {
      if (serverLeft <= 0 && !nowSealed) {
        window.__roomLeftSec = 0;
        window.__roomFpSec = serverFp;
        window.__roomNextSn = nextSn || window.__roomNextSn;
        window.__roomDeadlineMs = 0;
        clearDeadlineLock();
        window.__roomWaitingDraw = true;
        window.__roomSealed = false;
        row.letf_time = 0;
        row.fp_time = window.__roomFpSec;
        row.waiting_draw = 1;
        row.draw_status = 'drawing';
        return;
      }
      window.__roomWaitingDraw = false;
      window.__roomSealed = nowSealed;
      if (typeof window.scheduleOpenInfoBurst === 'function') window.scheduleOpenInfoBurst(1200);
      if (nowSealed) {
        window.__roomLeftSec = 0;
        window.__roomDeadlineMs = 0;
        clearDeadlineLock();
      } else {
        var d0 = deadlineFromRow(serverLeft, row);
        window.__roomDeadlineMs = lockDeadlineMs(d0, nextNorm || nextSn, sealSec);
        window.__roomLeftSec = localLeftSec();
      }
      window.__roomFpSec = serverFp;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      row.letf_time = window.__roomLeftSec;
      row.fp_time = window.__roomFpSec;
      return;
    }

    window.__roomWaitingDraw = false;

    if (nowSealed) {
      window.__roomSealed = true;
      window.__roomLeftSec = 0;
      window.__roomDeadlineMs = 0;
      clearDeadlineLock();
      window.__roomFpSec = serverFp;
      window.__roomNextSn = nextSn || window.__roomNextSn;
      row.letf_time = 0;
      row.fp_time = window.__roomFpSec;
      return;
    }

    window.__roomSealed = false;

    if (!hasBetClose && !termChanged && localLeft <= 8 && serverLeft >= localLeft + 12 && !row.next_at) {
      window.__roomFpSec = serverFp;
      window.__roomLeftSec = localLeft;
      row.letf_time = window.__roomLeftSec;
      row.fp_time = window.__roomFpSec;
