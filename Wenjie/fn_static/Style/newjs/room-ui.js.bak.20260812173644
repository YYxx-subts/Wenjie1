      rows += '<div class="fn-bet-line" style="display:flex!important;align-items:center!important;justify-content:space-between!important;gap:6px!important;min-height:36px!important;padding:6px 8px!important;border-bottom:1px solid #eee!important;font-size:14px!important;color:#4b4b4b!important;box-sizing:border-box!important;">'
