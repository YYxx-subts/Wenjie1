  /** —— 乐观注单：发送瞬间先出 @ + 报表，回包后再换成正式消息 —— */
  function escHtml(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function hezhiSplit(str) {
    // 对齐 PHP 和值分割：单独的 1 与下一位合并（19/10…）
    var arr = String(str).split('');
    var out = [];
    var ii_1_b = true;
    var ii_1 = '';
    for (var j = 0; j < arr.length; j++) {
      var ch = arr[j];
      var val = ch;
      if (!ii_1_b && ii_1 === '1') val = '1' + ch;
      ii_1 = ch;
      if (ii_1_b) ii_1_b = false;
      if (ch === '1') continue;
      out.push(val);
    }
    return out;
  }
  function digitChars(str) {
    return String(str).replace(/\D/g, '').split('');
  }
  function posTitle(mingci) {
    var map = {
      '1': '冠军', '2': '亚军', '3': '第三名', '4': '第四名', '5': '第五名',
      '6': '第六名', '7': '第七名', '8': '第八名', '9': '第九名', '0': '第十名', '10': '第十名',
      '和': '冠亚和', '合': '冠亚和'
    };
    return map[String(mingci)] || String(mingci);
  }
  function betOdds(mingci, content) {
    var o = window.ROOM_BET_ODDS || {};
    var c = String(content);
    if (mingci === '和' || mingci === '合') {
      if (c === '大') return o.heda || o.da || '1.988';
      if (c === '小') return o.hexiao || o.xiao || '1.988';
      if (c === '单') return o.hedan || o.dan || '1.988';
      if (c === '双') return o.heshuang || o.shuang || '1.988';
      return o.tema || '9.88';
    }
    if (c === '大') return o.da || '1.988';
    if (c === '小') return o.xiao || '1.988';
    if (c === '单') return o.dan || '1.988';
    if (c === '双') return o.shuang || '1.988';
    if (c === '龙') return o.long || '1.988';
    if (c === '虎') return o.hu || '1.988';
    if (c === '大单') return o.dadan || '3.8';
    if (c === '小单') return o.xiaodan || '3.8';
    if (c === '大双') return o.dashuang || '3.8';
    if (c === '小双') return o.xiaoshuang || '3.8';
    return o.tema || '9.88';
  }
  function parseOptimisticOrders(content) {
    var orders = [];
    var chunks = String(content || '').replace(/^\s+|\s+$/g, '').split(/\s+/);
    for (var ci = 0; ci < chunks.length; ci++) {
      var ai = String(chunks[ci] || '').replace(/\s/g, '');
      if (!ai) continue;
      if (ai.charAt(0) === '/') ai = '1' + ai;
      var b = ai.split('/');
      if (b.length === 2) b = ['1', b[0], b[1]];
      if (b.length !== 3) continue;
      var money = parseInt(b[2], 10);
      if (!(money > 0)) continue;
      var p0 = b[0];
      var p1 = b[1];
      if (p0 === '和' || p0 === '合') {
        if (/^(大|小|单|双)$/.test(p1)) {
          orders.push({ mingci: '和', content: p1, money: money });
        } else {
          var hz = hezhiSplit(p1);
          for (var hi = 0; hi < hz.length; hi++) {
            orders.push({ mingci: '和', content: hz[hi], money: money });
          }
        }
        continue;
      }
      if (/^(大单|小单|大双|小双|大|小|单|双|龙|虎)$/.test(p1)) {
        var ps = digitChars(p0);
        for (var pi = 0; pi < ps.length; pi++) {
          orders.push({ mingci: ps[pi], content: p1, money: money });
        }
        continue;
      }
      var pos = digitChars(p0);
      var nums = digitChars(p1);
      for (var a = 0; a < pos.length; a++) {
        for (var n = 0; n < nums.length; n++) {
          orders.push({ mingci: pos[a], content: nums[n], money: money });
        }
      }
    }
    return orders;
  }
  function buildOptimisticSlipHtml(term, orders) {
    if (!orders || !orders.length) return '';
