      + '<b style="color:#fff!important;font-weight:700;">' + termText + '期</b>'
      + '<a href="javascript:;" class="fn-bet-follow" data-bet="' + followText + '" onclick="var t=this.getAttribute(\'data-bet\');var i=document.querySelector(\'.keyb-input textarea\');if(i&&t){i.value=t;i.focus();}return false;" style="display:inline-flex!important;align-items:center!important;gap:4px!important;border:0!important;border-radius:4px!important;padding:4px 9px!important;background:#fff!important;color:#168da8!important;font-size:13px!important;font-weight:800!important;text-decoration:none!important;">跟投</a>'
      + '</div><div class="fn-bet-lines">' + rows + '</div>'
      + '<div class="fn-bet-ft" style="padding:8px 10px!important;text-align:left!important;font-size:13px!important;color:#5a6b73!important;">注单' + orders.length + '条，总计：<strong style="color:#d32632!important;">¥' + total.toFixed(2) + '</strong></div></div>';
  }
