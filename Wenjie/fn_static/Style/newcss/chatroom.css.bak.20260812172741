  justify-content: center;
  opacity: 0;
  transform: translateY(-12px);
  transition: opacity .28s ease, transform .28s ease;
}
.fn-vip-entry.is-show{
  opacity: 1;
  transform: translateY(0);
}
.fn-vip-entry-inner{
  min-width: 56%;
  max-width: 86%;
  padding: 0.18rem 0.36rem;
  border-radius: 999px;
  background: linear-gradient(90deg,rgba(20,16,8,.82),rgba(90,60,10,.88),rgba(20,16,8,.82));
  color: #ffe7a3;
  text-align: center;
  box-shadow: 0 8px 24px rgba(0,0,0,.28);
  border: 1px solid rgba(240,193,75,.45);
}
.fn-vip-entry-text{
  font-size: 0.3rem;
  letter-spacing: 0.02rem;
  font-weight: 600;
}
.chat-content .info-content{word-break: break-all;word-wrap: break-word;font-size: 0.25rem;}
.chat-content .info-content img{
  max-width: 46vw !important;
  max-height: 20vh !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain;
  border-radius: 6px;
  cursor: zoom-in;
  display: block;
  margin-top: 0.08rem;
}
/* 开奖结果图：完整显示，不再裁右侧（旧 clip 会把时时彩图压成竖条） */
.open-result-wrap{
  position: relative;
  display: inline-block;
  max-width: 46vw;
  max-height: 20vh;
  overflow: hidden;
  border-radius: 6px;
  line-height: 0;
  vertical-align: top;
}
.open-result-wrap img.open-result-img,
.open-result-wrap img{
  max-width: 46vw !important;
  max-height: 20vh !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain;
  display: block;
}
body.room-has-live .open-result-wrap{
  cursor: pointer;
}
.chat-content .content-box .content-info{
  max-width: 78%;
}
/* 图片点击放大 */
.room-img-lightbox{
  display: none;
  position: fixed;
  inset: 0;
  z-index: 99999;
  background: rgba(0,0,0,0.88);
  align-items: center;
  justify-content: center;
  padding: 0.3rem;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}
.room-img-lightbox.is-open{display: flex;}
.room-img-lightbox img{
  max-width: 96vw;
  max-height: 90vh;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 4px;
}
.chat-input{display: flex;flex-direction: row;padding: 0.1rem 0.2rem;background: #FFFFFF;align-items: center;position: relative;z-index: 2;}
.chat-input .keyb-input{flex-grow: 10;height: 0.4rem;background: #EFEFEF;border-radius: 7px;margin: 0rem 0.2rem;padding:0.1rem 0px;display: flex;align-items: center;justify-content: flex-start;text-indent: 0.1rem;outline: none;font-size: 0.25rem;overflow: hidden}
.chat-input .keyb-input:focus:before{
    content:none;
}
.chat-input .keyb-left img{width: 0.4rem}
.chat-input .keyb-right img{width: 0.4rem}

/* 底部输入栏+键盘压在右侧悬浮按钮之上，避免挡键 */
.room-bottom-dock{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 400;
  background: #fff;
}

.keybaord{background: #EFEFEF;display: flex;width: 100%;flex-direction: column;position: relative;z-index: 401;}
/* App WebView 键盘：禁止触摸时滚动/系统合成 click 改变命中坐标。 */
.keybaord,.keybaord *{touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;}
.keybaord li{cursor:pointer;}
.keybaord .numbaord{display: flex;flex-wrap: wrap;margin:0.1rem 0rem;box-sizing: border-box;}
.keybaord .numbaord li{width: calc(20% - 2px);background: #FFFFFF;height: 0.7rem;margin-top: 2.5px;margin-left: 2.5px;display: flex;justify-content: center;align-items: center;border-radius: 7px;color: #ADACAD;font-size: 0.3rem;flex-grow: 0;}
.keybaord .numbaord li.rowstart{margin-left: 0px;}
.keybaord .numbaord li.delimg img{width: 0.4rem}
.keybaord .numbaord li.zlong{background: #FE4438;color: white;}
.keybaord .numbaord li.zhu{background: #178DFF;color: white;}
.keybaord .numbaord li.zgyh{background: #28A833;color: white;}

/* 弹珠28：三行快捷栏 + 4×5 主键盘（加拿大28玩法二） */
.keybaord.is-pc28-kb{
  background: #ececec;
  padding: 0 0 0.06rem;
  box-sizing: border-box;
}
/* 快捷栏1：竖线分隔（样式不同于下面两栏） */
.keybaord.is-pc28-kb .pc28-quick-line{
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff;
  margin: 0;
  padding: 0;
}
.keybaord.is-pc28-kb .pc28-quick-line li{
  flex: 1 1 0;
  height: 0.64rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.24rem;
  color: #888;
  background: #fff;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  position: relative;
}
.keybaord.is-pc28-kb .pc28-quick-line li + li::before{
  content: "";
