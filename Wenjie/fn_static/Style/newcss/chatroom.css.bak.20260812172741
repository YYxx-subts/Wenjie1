/* 弹珠28 房间顶栏：圆球等式 */
.current-sn.is-pc28 .num-sn{
  justify-content: center;
  gap: 0.06rem;
  padding: 0 0.06rem;
}
.current-sn .pc28-ball,
.history-row .pc28-ball{
