}
.room-side-fabs a,
.room-side-fabs button,
.room-side-fabs .fab-btn{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 0.86rem;
  height: 0.86rem;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  overflow: visible;
  background: transparent !important;
  outline: none !important;
  box-shadow: none !important;
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  user-select: none;
  appearance: none;
  -webkit-appearance: none;
  touch-action: manipulation;
  cursor: pointer;
}
.back{
  touch-action: manipulation;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  position: relative;
  z-index: 5;
}
.room-side-fabs a:active,
.room-side-fabs a:focus,
.room-side-fabs button:active,
.room-side-fabs button:focus,
.room-side-fabs .fab-btn:active,
.room-side-fabs .fab-btn:focus{
  background: transparent !important;
  outline: none !important;
}
.room-side-fabs img{
  display: block;
  width: 0.86rem;
  height: 0.86rem;
  object-fit: contain;
  pointer-events: none;
  background: transparent;
