}
.pc28-ball.pc-g{background:#1ec45a !important;}
.pc28-ball.pc-b{background:#2f86f6 !important;}
.pc28-ball.pc-r{background:#e53935 !important;}
.pc28-ball.pc-y{background:#f0b429 !important;}
.current-sn .pc28-op,
.history-row.is-pc28 .pc28-op,
.history-row.is-pc28 .numrow span.pc28-op{
