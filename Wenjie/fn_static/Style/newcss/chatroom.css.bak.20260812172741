}
.history-row.is-pc28 .col-gy{
  width: 2.1rem;
  min-width: 2.1rem;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.08rem;
  flex-grow: 0;
  flex-shrink: 0;
  padding: 0 0.04rem 0 0.08rem;
  box-sizing: border-box;
}
.history-row.is-pc28 .col-gy .pc28-ball,
.history-row.is-pc28 .col-gy .pc28-ball.is-sum{
  width: 0.4rem !important;
  height: 0.4rem !important;
  flex: 0 0 0.4rem !important;
  margin: 0 !important;
}
.history-row.is-pc28 .numrow span.pc28-ball{
  width: 0.36rem !important;
  height: 0.36rem !important;
  margin: 0 !important;
  border-radius: 50% !important;
  text-shadow: none !important;
}
/* 表头「号码」不要套奖球窄宽，保持一行 */
.history-row.titlehi.is-pc28 .col-num,
.history-row.titlehi.is-pc28 .col-num.numrow{
  gap: 0 !important;
}
.history-row.titlehi.is-pc28 .col-num span,
.history-row.titlehi.is-pc28 .numrow span{
  width: auto !important;
  height: auto !important;
  flex: 0 0 auto !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 0 !important;
  background: none !important;
  color: #8B8B8B !important;
  text-shadow: none !important;
  font-weight: normal !important;
  white-space: nowrap !important;
  display: inline !important;
}
.pc28-txt-da{color:#e53935;font-weight:600;white-space:nowrap;}
.pc28-txt-xiao{color:#2f86f6;font-weight:600;white-space:nowrap;}
.history-row.titlehi.is-pc28 .col-num{justify-content: center !important;}
.history-row.titlehi.is-pc28 .col-gy{
  width: 2.1rem;
  min-width: 2.1rem;
  text-align: left;
  justify-content: flex-start;
}

.chat-content .last-show{}
