}
.room-game-switch.is-open{display: block;}
.room-game-switch li{list-style: none;margin: 0.08rem 0;}
.room-game-switch a{display: flex;align-items: center;gap: 0.08rem;color: #228fff;text-decoration: none;-webkit-tap-highlight-color: transparent;}
.room-game-switch img.imgst{width: 0.4rem;height: 0.4rem;}
.fmaint{color:#e53935 !important;font-weight:600 !important;white-space:nowrap;}
/* 直播引导：灰色蒙版 + 提示图 + 今日不再提示 + 知道了 */
.room-live-guide{
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10050;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0.4rem 0.36rem;
  -webkit-tap-highlight-color: transparent;
}
.room-live-guide.is-on{
  display: flex !important;
  animation: roomLiveGuideFadeIn .28s ease-out;
  -webkit-animation: roomLiveGuideFadeIn .28s ease-out;
}
.room-live-guide.is-leaving{
  animation: roomLiveGuideFadeOut .45s linear forwards;
  -webkit-animation: roomLiveGuideFadeOut .45s linear forwards;
  pointer-events: none;
}
.room-live-guide-mask{
  position: absolute;
  inset: 0;
  background: rgba(70, 70, 70, 0.72);
  background-image: url(/Style/newimg/guide/live_guide_mask.png?v=20260730g1);
  background-size: 100% 100%;
  background-repeat: no-repeat;
  opacity: 0.85;
  pointer-events: none;
}
.room-live-guide-panel{
  position: relative;
  z-index: 1;
  width: 3.7rem;
  max-width: 64vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.14rem;
  transform: translateY(0.55rem);
  -webkit-transform: translateY(0.55rem);
}
.room-live-guide-tip{
  display: block;
  width: 100%;
  height: auto;
  pointer-events: none;
  user-select: none;
  -webkit-user-drag: none;
}
.room-live-guide-today{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.08rem;
  margin: 0;
  color: #fff;
  font-size: 0.22rem;
  line-height: 1.2;
  font-weight: 500;
  -webkit-user-select: none;
  user-select: none;
  cursor: pointer;
}
.room-live-guide-today input{
  width: 0.26rem;
  height: 0.26rem;
  margin: 0;
  accent-color: #2f8dff;
}
.room-live-guide-ok{
  appearance: none;
  -webkit-appearance: none;
  display: block;
  width: 1.65rem;
  max-width: 38%;
  margin: 0.02rem 0 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 0;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.room-live-guide-ok img{
  display: block;
  width: 100%;
  height: auto;
  pointer-events: none;
}
@keyframes roomLiveGuideFadeIn{
  from{ opacity: 0; }
  to{ opacity: 1; }
}
@-webkit-keyframes roomLiveGuideFadeIn{
  from{ opacity: 0; }
  to{ opacity: 1; }
}
@keyframes roomLiveGuideFadeOut{
  from{ opacity: 1; }
  to{ opacity: 0; }
}
@-webkit-keyframes roomLiveGuideFadeOut{
  from{ opacity: 1; }
  to{ opacity: 0; }
}
