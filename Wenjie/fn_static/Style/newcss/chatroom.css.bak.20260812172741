}
.keybaord.is-pc28-kb .pc28-numboard li.kb-side{
  background: #c8c8c8;
  border-color: #bcbcbc;
  color: #333;
  font-weight: 600;
}
.keybaord.is-pc28-kb .pc28-numboard li.kb-num{
  background: #fff;
  color: #333;
}
.keybaord.is-pc28-kb .pc28-numboard li.kb-del{
  background: #c8c8c8;
  border-color: #bcbcbc;
}
.keybaord.is-pc28-kb .pc28-numboard li.kb-del img,
.keybaord.is-pc28-kb .pc28-numboard li.delimg img{
  width: 0.42rem;
}
.keybaord.is-pc28-kb .pc28-numboard li.kb-wave{
  background: #fff;
  font-size: 0.2rem;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
  padding: 0 0.02rem;
}
.keybaord.is-pc28-kb .pc28-numboard li.kb-red{color: #e53935;}
.keybaord.is-pc28-kb .pc28-numboard li.kb-green{color: #1ec45a;}
.keybaord.is-pc28-kb .pc28-numboard li.kb-blue{color: #2f86f6;}

