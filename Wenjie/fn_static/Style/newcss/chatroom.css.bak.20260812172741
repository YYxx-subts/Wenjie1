  color: #555;
  font-size: 0.22rem;
  flex-shrink: 0;
}
.history-row.is-pc28 .col-num,
.history-row.is-pc28 .col-num.numrow{
  justify-content: center !important;
  align-items: center !important;
  gap: 0.05rem !important;
  flex-wrap: nowrap;
