/* 禁止房间页整页橡皮筋拉伸：只允许聊天区内部滚动 */
:root{
  --fn-status-bar: 0px;
  --fn-safe-top: max(env(safe-area-inset-top, 0px), var(--fn-status-bar, 0px));
  /* 比状态栏再收一点，避免顶栏空得过大 */
  --fn-room-safe: max(0px, calc(var(--fn-safe-top) - 10px));
}
html, body{
  width: 100%;
  max-width: 100%;
  height: 100%;
  overflow: hidden;
  overflow-x: clip;
  overscroll-behavior: none;
  overscroll-behavior-x: none;
  -webkit-overflow-scrolling: auto;
}
.mainbox{
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;
}
.chat-content{
  flex: 1 1 auto;
  min-height: 0;
  background: #EFEFEF;
  /* block 滚动比 flex 容器 overflow 更稳，避免一键回底留白 */
  display: block;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 1.8rem;
  overscroll-behavior: none;
  overscroll-behavior-y: none;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
}
.chat-content .last-show{
  display: block;
  width: 100%;
}
#chatBt{
  height: 2px;
  width: 100%;
  clear: both;
  pointer-events: none;
}
/* 固定顶栏：蓝底延伸进状态栏，文字/按钮落在安全区下方 */
.room-fixed-head{
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  height: auto;
  min-height: calc(var(--fn-room-safe) + 2.1rem);
  background-color: #fff;
  overflow: visible;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.roomtop{
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: calc(0.1rem + var(--fn-room-safe)) 0.2rem 0.1rem;
  min-height: calc(0.7rem + var(--fn-room-safe));
  height: auto !important;
  box-sizing: border-box;
  background: #2f86e0;
  background-image: linear-gradient(90deg, #2b7adb 0%, #3aa6e8 52%, #4fc0f0 100%);
  color: white;
  border: 0;
  outline: 0;
}
.roomtop .back{width: 40%;flex-grow: 0;display: flex;justify-content: flex-start;align-items: center;font-size: 0.3rem;font-weight: bold}
.roomtop .back img{width: 0.2rem;margin-right: 0.2rem}
.roomtop .show-info{width: 60%;flex-grow: 0;display: flex;flex-wrap: wrap;}
.roomtop .show-info li{width: 50%;margin-top: 0.1rem;margin-bottom:0.05rem;font-size: 0.2rem;}
.chat-content.has-room-head{
  padding-top: calc(2.5rem + var(--fn-room-safe)) !important;
}


