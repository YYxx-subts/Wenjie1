}
.keybaord.is-pc28-kb .pc28-numboard li{
  width: calc((100% - 12px) / 5);
  height: 0.8rem;
  margin: 0 3px 3px 0;
  border-radius: 6px;
  border: 1px solid #d5d5d5;
  font-size: 0.28rem;
  color: #555;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
