  left: 0;
  top: 18%;
  bottom: 18%;
  width: 1px;
  background: #d8d8d8;
}
/* 快捷栏2、3：白底圆角按钮 */
.keybaord.is-pc28-kb .pc28-quick-btn{
  display: flex;
  flex-direction: row;
  gap: 3px;
