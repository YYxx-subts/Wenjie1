.history-row{display: flex;flex-direction: row;align-items: center;width: 100%;font-size: 0.2rem;margin: 0.06rem 0;}
.history-row.titlehi{border-bottom: 1px solid #DEDEDE;color: #8B8B8B;padding: 0.06rem 0;margin: 0;}
.history-row.titlehi span{color: #8B8B8B;text-shadow:none;font-weight: normal}
.history-row .col-num{flex-grow: 10;display: flex;justify-content: center}
.history-row .col-lh{width: 2rem;flex-grow: 0;flex-shrink: 0}
.history-row .col-gy{width: 0.9rem;flex-grow: 0;flex-shrink: 0;text-align: center}
.history-row .col-qh{width: 0.7rem;flex-grow: 0;flex-shrink: 0}
.col-lh span.gray,.col-gy span.gray{color: red}
.col-lh span.blue,.col-gy span.blue{color: #4283E5}
.numrow span{width: 0.3rem;height: 0.3rem;border-radius: 5px;display: flex;justify-content: center;align-items: center;border-radius: 3px;text-shadow: 0 0 1px #000;color: white;font-weight: 700;margin-left: 1px;}


.forecast-row{display: flex;justify-content: start;align-items: center;font-size: 0.24rem;border-bottom: 1px solid #DEDEDE;width: 100%;}
.forecast-row .for-sn{width: 2rem;display: flex;justify-content: center;}
.forecast-row .for-title,.forecast-row .for-num{
    /*flex-grow: 10;*/
    flex-shrink: 0;justify-content: center;display: flex;
    width: 40%;
    
}
.forecast-row .for-zoushi1{
    /*flex-grow: 10;*/
    flex-shrink: 0;justify-content: center;display: flex;
    width: 20%;
    font-size: 0.15rem;
}
.forecast-row .for-zoushi2{
    /*flex-grow: 10;*/
    flex-shrink: 0;justify-content: center;display: flex;
    width: 10%;
    font-size: 0.15rem;
}
.forecast-row .for-dx,.forecast-row .for-ds{width: 1rem;display: flex;justify-content: center;align-items: center}
