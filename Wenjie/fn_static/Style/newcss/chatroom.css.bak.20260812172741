/* 自助回水底部弹层 */
.fn-hs-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,.45);z-index:9999;display:flex;align-items:flex-end;justify-content:center}
.fn-hs-sheet{width:100%;background:#fff;border-radius:.2rem .2rem 0 0;padding:.36rem .4rem calc(.36rem + env(safe-area-inset-bottom));box-sizing:border-box}
.fn-hs-title{text-align:center;font-size:.34rem;color:#222;font-weight:600;margin-bottom:.28rem}
.fn-hs-row{display:flex;align-items:center;justify-content:space-between;padding:.22rem 0;border-bottom:1px solid #eee;font-size:.28rem;color:#333}
.fn-hs-row b{font-weight:600;color:#222}
.fn-hs-actions{display:flex;align-items:center;justify-content:center;gap:.8rem;padding:.4rem 0 .1rem}
.fn-hs-cancel,.fn-hs-ok{background:none;border:0;font-size:.3rem;padding:.1rem .2rem}
.fn-hs-cancel{color:#333}
.fn-hs-ok{color:#2f7bff}

/*异步弹窗：贴紧开奖结果栏，去掉顶部分隔缝*/
#iframeBox{position: absolute;top: 100%;left: 0;background: #fff;padding: 0 0.2rem 0.1rem;border: 0;border-top: 0;display: none;width: 100%;box-sizing: border-box;max-height: 250%;overflow-y: auto;overflow-x: hidden;z-index: 101;}

