/* 直播画面：跟在开奖结果栏下方，随顶栏一起撑开 */
.room-live-panel{
  display: block;
  position: relative;
  left: auto;
  top: auto;
  width: 100%;
  height: 0;
  visibility: hidden;
  z-index: 1;
  flex: 0 0 auto;
  background: #000;
  overflow: hidden;
}
.room-live-panel.is-open{height: auto; visibility: visible;}
.room-live-panel iframe{
  display: block;
  width: 100% !important;
  height: 56.25vw;
  max-height: 280px;
  min-height: 180px;
  border: 0;
  margin: 0;
  padding: 0;
  background: #000;
}
.room-game-switch{
  display: none;
  position: fixed;
  right: 0.9rem;
  top: auto;
  bottom: max(2.4rem, 26vh);
  z-index: 260;
  width: 1.6rem;
  max-height: 60vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.18);
