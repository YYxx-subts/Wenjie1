/* 一键返回底部（对齐名爵 .home-content .bottom） */
.fn-chat-to-bottom{
  position: fixed;
  right: 0.18rem;
  bottom: calc(1.05rem + env(safe-area-inset-bottom, 0px));
  width: 0.72rem;
  height: 0.72rem;
  border: 0;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: url(/Style/newimg/to_bottom.png) center / 100% 100% no-repeat;
  background-color: transparent;
  box-shadow: 0 2px 8px rgba(0,0,0,.12);
  z-index: 220;
  cursor: pointer;
  display: none;
  -webkit-tap-highlight-color: transparent;
  appearance: none;
  -webkit-appearance: none;
}
.fn-chat-to-bottom.is-show{ display: block; }
.fn-chat-to-bottom.is-kb-open{
  /* 由 room-ui 按真实底部输入栏高度动态写入，避免不同屏幕 rem 不一致导致按钮跑到中间 */
  bottom: calc(var(--fn-chat-dock-height, 5.6rem) + env(safe-area-inset-bottom, 0px));
}
.fn-chat-to-bottom .fn-chat-unread{
  position: absolute;
  top: -0.06rem;
  right: -0.06rem;
  min-width: 0.32rem;
  height: 0.32rem;
  padding: 0 0.06rem;
  box-sizing: border-box;
  border-radius: 0.32rem;
  background: #ff6a6a;
  color: #fff;
  font-size: 0.2rem;
  line-height: 0.32rem;
  text-align: center;
  font-weight: 700;
  display: none;
}
.fn-chat-to-bottom .fn-chat-unread.is-on{ display: block; }

/* 右侧悬浮按钮：紧挨切换按钮向下排列，去掉点击蓝底 */
.room-side-fabs{
  position: fixed;
