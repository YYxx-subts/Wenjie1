// 新页面统一从右侧进入：只动画当前新文档，不移动旧页面截图，避免白屏和旧页滑出。
(function feiniaoPageEnter() {
    var css = '@keyframes fnPageEnter{from{transform:translate3d(100%,0,0)}to{transform:translate3d(0,0,0)}}' +
        'html.fn-page-enter{overflow-x:hidden;background:#fff}' +
        'html.fn-page-enter body{animation:fnPageEnter .42s cubic-bezier(.22,.61,.36,1) both;backface-visibility:hidden;transform-origin:0 50%;will-change:transform}';
    try {
        var style = document.createElement('style');
        style.id = 'fn-page-enter-style';
        style.textContent = css;
        (document.head || document.documentElement).appendChild(style);
    } catch (e) {}
    function start() {
        if (window.__FN_NATIVE_PAGE_TRANSITION__) return;
        try {
            var nav = window.performance && performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
            if (nav && nav.type === 'back_forward') return;
            if (!document.body || document.documentElement.classList.contains('fn-page-enter')) return;
            document.documentElement.classList.add('fn-page-enter');
            document.body.addEventListener('animationend', function () {
                document.documentElement.classList.remove('fn-page-enter');
            }, { once: true });
        } catch (e) {}
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, false);
    else start();
})();

// 页面级即时加载提示：只覆盖当前文档，真正导航完成后由下一页自然消失。
(function feiniaoPageLoading() {
    var timer = null;
    var navBusy = false;
    var lastTouchNavAt = 0;
    function ensureStyle() {
        if (document.getElementById('fn-page-loading-style')) return;
        var s = document.createElement('style'); s.id = 'fn-page-loading-style';
        s.textContent = '.fn-page-loading{position:fixed;inset:0;background:rgba(20,35,48,.96);z-index:2147483646;display:flex;align-items:center;justify-content:center;pointer-events:none}.fn-page-loading-box{width:96px;height:96px;border-radius:16px;background:rgba(60,70,78,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font:300 17px/1.2 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.fn-page-loading-dots{display:flex;gap:6px;margin-bottom:17px}.fn-page-loading-dots i{width:11px;height:14px;border-radius:99px;background:#e2e7f1;animation:fnLoadingDot 1.4s ease-in-out infinite}.fn-page-loading-dots i:nth-child(2){animation-delay:.22s}.fn-page-loading-dots i:nth-child(3){animation-delay:.44s}@keyframes fnLoadingDot{0%,100%{transform:translateY(3px) scale(.7)}50%{transform:translateY(-3px) scale(1.15)}}.fn-page-loading-spinner{width:42px;height:42px;margin-bottom:10px;position:relative}.fn-page-loading-spinner img{position:absolute;inset:0;width:42px;height:42px;object-fit:contain}.fn-pending-nav>body>*:not(#fn-page-loading){visibility:hidden!important}';
        (document.head || document.documentElement).appendChild(s);
    }
    window.fnShowPageLoading = function (text) {
        ensureStyle();
        var old = document.getElementById('fn-page-loading'); if (old) old.remove();
        var box = document.createElement('div'); box.id = 'fn-page-loading'; box.className = 'fn-page-loading';
        var isRoomEnter = String(text || '') === '循环加载';
        box.innerHTML = '<div class="fn-page-loading-box">' + (isRoomEnter ? '<div class="fn-page-loading-spinner"></div>' : '<div class="fn-page-loading-dots"><i></i><i></i><i></i></div>') + '<div>' + String(text || '正在加载').replace(/[<>&]/g, '') + '</div></div>';
        var spinner = box.querySelector('.fn-page-loading-spinner');
        if (spinner) { for (var i=1;i<=12;i++) { var img=document.createElement('img'); img.src='/Style/newimg/loading/loading_' + (i<10?'0':'') + i + '.png?v=20260812frames1'; img.style.display=i===1?'block':'none'; spinner.appendChild(img); } var frame=0; box.__frameTimer=setInterval(function(){ var imgs=spinner.querySelectorAll('img'); if(!imgs.length)return; imgs[frame].style.display='none'; frame=(frame+1)%imgs.length; imgs[frame].style.display='block'; },80); }
        (document.body || document.documentElement).appendChild(box);
        clearTimeout(timer); timer = setTimeout(function () { window.fnHidePageLoading(); }, 30000);
    };
    window.fnHidePageLoading = function () { clearTimeout(timer); var el = document.getElementById('fn-page-loading'); if (el && el.__frameTimer) clearInterval(el.__frameTimer); if (el) el.remove(); };
    function waitForResource(url, kind) {
        return new Promise(function (resolve) {
            var done = false, finish = function () { if (!done) { done = true; resolve(); } };
            var t = setTimeout(finish, 15000);
            if (kind === 'img') { var img = new Image(); img.onload = img.onerror = function () { clearTimeout(t); finish(); }; img.src = url; }
            else { fetch(url, { credentials: 'include', cache: 'default' }).then(function () { clearTimeout(t); finish(); }, function () { clearTimeout(t); finish(); }); }
        });
    }
    function prefetchPage(url) {
        var absolute = new URL(url, location.href).href;
        return fetch(absolute, { credentials: 'include', cache: 'default' }).then(function (response) {
            if (!response.ok) throw new Error('navigation fetch failed');
            return response.text();
        }).then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var urls = [], push = function (raw, kind) {
                if (!raw || /^(data:|blob:|javascript:|#)/i.test(raw)) return;
                try { var u = new URL(raw, absolute); if (u.origin === location.origin) urls.push({ url: u.href, kind: kind }); } catch (e) {}
            };
            doc.querySelectorAll('img[src]').forEach(function (el) { push(el.getAttribute('src'), 'img'); });
            doc.querySelectorAll('link[rel~="stylesheet"][href]').forEach(function (el) { push(el.getAttribute('href'), 'css'); });
            doc.querySelectorAll('script[src]').forEach(function (el) { push(el.getAttribute('src'), 'script'); });
            var unique = [], seen = {};
            urls.forEach(function (item) { if (!seen[item.url]) { seen[item.url] = true; unique.push(item); } });
            var waits = unique.map(function (item) { return waitForResource(item.url, item.kind); });
            // 大厅轮播由接口异步返回，HTML 预取本身不会包含它；先取接口并预加载返回图片。
            if (/do=gamelist/i.test(absolute)) {
                var roomMatch = html.match(/FEINIAO_ROOM_ID\s*=\s*["']([^"']*)["']/i);
                var roomId = roomMatch ? roomMatch[1] : '';
                var api = '/api_room_promos.php?roomid=' + encodeURIComponent(roomId) + '&_=' + Date.now();
                waits.push(fetch(new URL(api, absolute).href, { credentials: 'include', cache: 'no-store' }).then(function (res) { return res.json(); }).then(function (payload) {
                    var rows = payload && payload.data && Array.isArray(payload.data.banners) ? payload.data.banners : [];
                    try { if (roomId && rows.length) sessionStorage.setItem('fn_home_banners_cache_v2_' + roomId, JSON.stringify({ t: Date.now(), payload: payload })); } catch (e) {}
                    return Promise.all(rows.map(function (row) { return waitForResource(row && (row.image || row.imageUrl || row.url), 'img'); }));
                }).catch(function () {}));
            }
            return Promise.all(waits);
        });
    }
    function navigateAfterPrefetch(url, label, event) {
        if (navBusy) { if (event) event.preventDefault(); return; }
        navBusy = true;
        if (event) { event.preventDefault(); event.stopImmediatePropagation(); }
        try { sessionStorage.setItem('fn_pending_navigation', JSON.stringify({ url: url, label: label, at: Date.now() })); } catch (e) {}
        window.fnShowPageLoading(label);
        prefetchPage(url).catch(function () {}).then(function () {
            window.fnHidePageLoading();
            location.href = url;
        });
    }
    window.fnNavigateAfterPrefetch = function (url, label) {
        navigateAfterPrefetch(new URL(url, location.href).href, label || '正在加载', null);
    };
    function pageGateReady() {
        var path = location.pathname + location.search;
        var images = Array.prototype.slice.call(document.images || []);
        images.forEach(function (img) {
            if (img.loading === 'lazy' && !img.complete) {
                img.loading = 'eager';
                var src = img.currentSrc || img.src;
                if (src) img.src = src;
            }
        });
        var imagesReady = images.every(function (img) { return img.complete && img.naturalWidth > 0; });
        if (!imagesReady) return false;
        if (/do=gamelist/i.test(path)) {
            var banner = document.getElementById('homeBanner');
            var cards = document.querySelectorAll('.game-box');
            return window.__fnHallBannerReady === true && window.__fnHallDataReady === true && !!banner && !!banner.querySelector('img') && cards.length > 0;
        }
        if (/do=roomdoor/i.test(path)) {
            return !!document.querySelector('#numinput, .roomrow, .room-list, .history-room');
        }
        return !!document.body && document.body.children.length > 0;
    }
    function armPageGate() {
        var pending = null;
        try { pending = JSON.parse(sessionStorage.getItem('fn_pending_navigation') || 'null'); } catch (e) {}
        if (!pending) {
            if (/do=roomdoor/i.test(location.pathname + location.search)) {
                window.fnShowPageLoading('正在加载');
                var roomStarted = Date.now();
                var roomCheck = function () {
                    if (pageGateReady() || Date.now() - roomStarted > 30000) window.fnHidePageLoading();
                    else setTimeout(roomCheck, 120);
                };
                roomCheck();
            }
            return;
        }
        window.fnShowPageLoading(pending.label || '正在加载');
        if (/do=gamelist/i.test(location.pathname + location.search)) document.documentElement.classList.add('fn-pending-nav');
        var started = Date.now();
        var check = function () {
            if (pageGateReady() || Date.now() - started > 30000) {
                try { sessionStorage.removeItem('fn_pending_navigation'); } catch (e) {}
                window.fnHidePageLoading();
                document.documentElement.classList.remove('fn-pending-nav');
                return;
            }
            setTimeout(check, 120);
        };
        if (document.readyState === 'complete') check();
        else window.addEventListener('load', check, { once: true });
    }
    document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || a.target === '_blank') return;
        var href = a.getAttribute('href') || '';
        if (/^(javascript:|#|mailto:|tel:)/i.test(href)) return;
        var target;
        try { target = new URL(href, location.href); } catch (err) { return; }
        if (target.origin !== location.origin || target.href === location.href) return;
        if (Date.now() - lastTouchNavAt < 700) { e.preventDefault(); return; }
        var label = /Templates\/(New|Old)\/.*Bet/i.test(href) ? '正在加入' : (/do=room(?:&|$)/i.test(href) ? '循环加载' : '正在加载');
        navigateAfterPrefetch(target.href, label, e);
    }, true);
    document.addEventListener('touchend', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-url],button[onclick],li[ontouchend]') : null;
        if (!el) return;
        var url = el.getAttribute('data-url') || '';
        var inline = el.getAttribute('ontouchend') || el.getAttribute('onclick') || '';
        if (url || /location\.(href|assign|replace)|feiniaoGo/i.test(inline)) { lastTouchNavAt = Date.now(); window.fnShowPageLoading('正在加载'); }
    }, true);
    document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('button, .pc-quick-item, .pc-grid-item, .pc-vip-link') : null;
        if (!el || el.id === 'pcCopyAccount' || el.id === 'vipDetailBtn') return;
        var href = el.getAttribute('href') || '';
        if (href && !/^(javascript:|#)/i.test(href)) window.fnShowPageLoading('正在加载');
    }, true);
    window.addEventListener('load', function () {
        var pending = false;
        try { pending = !!sessionStorage.getItem('fn_pending_navigation'); } catch (e) {}
        if (!pending) window.fnHidePageLoading();
    }, false);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', armPageGate, false);
    else armPageGate();
})();

// App 物理返回：HTML5+(plus) 与普通 WebView 都能尽量回上一页
var plusReady = function (callback) {
    if (window.plus) {
        callback();
    } else {
        document.addEventListener('plusready', callback);
    }
};

function feiniaoNavigateBack() {
    try {
        var path = (location.pathname || '') + (location.search || '');
        var href = location.href || '';
        // 与 App 壳、页内返回按钮一致的业务回退
        if (/do=room(?!door)/i.test(href) || /Templates\/room/i.test(path)) {
            if (window.history && history.length > 1) history.back();
            else location.href = '/action.php?do=gamelist';
            return;
        }
        if (/do=gamelist/i.test(href) || /do=kefu/i.test(href) || /Templates\/user\//i.test(path)) {
            location.href = '/action.php?do=roomdoor';
            return;
        }
        if (/do=roomdoor/i.test(href)) {
            location.href = '/action.php?do=login';
            return;
        }
        if (window.history && history.length > 1) {
            history.back();
            return;
        }
        location.href = '/action.php?do=gamelist';
    } catch (e) {
        try { history.back(); } catch (e2) {}
    }
}

window.feiniaoNavigateBack = feiniaoNavigateBack;

plusReady(function () {
    var firstBack = 0;
    var handleBack = function () {
        var now = Date.now || function () {
            return new Date().getTime();
        };
        try {
            var currentWebview = plus.webview.currentWebview();
            currentWebview.canBack(function (evt) {
                if (evt && evt.canBack) {
                    history.back();
                    return;
                }
                // 无 WebView 历史时走业务回退；入口页双击退出
                var href = location.href || '';
                if (/do=login/i.test(href)) {
                    if (!firstBack) {
                        firstBack = now();
                        plus.nativeUI.toast('再按一次退出应用');
                        setTimeout(function () { firstBack = 0; }, 2000);
                    } else if (now() - firstBack < 2000) {
                        plus.runtime.quit();
                    }
                    return;
                }
                feiniaoNavigateBack();
            });
        } catch (e) {
            feiniaoNavigateBack();
        }
    };
    plus.key.addEventListener('backbutton', handleBack);
});
