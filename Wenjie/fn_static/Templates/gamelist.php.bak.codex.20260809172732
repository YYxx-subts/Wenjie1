    function footerAction($li) {
        if (window.__fnNavigating) return;
        var action = $li.data('action');
        if (action === 'vip') {
            window.__fnNavigating = true;
            window.location.href = '/Templates/user/vip.php';
            return;
        }
        if (action === 'promo') {
            var banner = document.getElementById('homeBanner');
            if (banner) {
                banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return;
        }
        if (action === 'roomintro') {
            window.__fnNavigating = true;
            window.location.href = '/Templates/roomintro.php';
            return;
        }
        var url = $li.data('url');
        if (url) {
            window.__fnNavigating = true;
            window.location.href = url;
        }
    }
    $('.footer_menu2 li').off('.fnfooter').on('click.fnfooter', function (e) {
        if (window.__fnFooterTouchAt && Date.now() - window.__fnFooterTouchAt < 700) {
            e.preventDefault();
            return;
        }
        footerAction($(this));
    }).on('touchend.fnfooter', function (e) {
        window.__fnFooterTouchAt = Date.now();
        e.preventDefault();
        footerAction($(this));
    });
    // 返回大厅只保留一条触摸/click 事件链，避免 touchend、pointerup、click
    // 多次竞争导致 preventDefault 后既不弹窗也不跳转。
    (function bindHallBack() {
        var hallBackBusy = false;
        var lastTouchAt = 0;
        var backUrl = '/action.php?do=roomdoor';
        function goBack() {
            if (hallBackBusy || window.__fnNavigating) return;
            hallBackBusy = true;
            window.__fnExitPromptOpen = true;
            var leave = function () {
                window.__fnNavigating = true;
                window.__fnExitPromptOpen = false;
                window.location.href = backUrl;
            };
            var cancel = function () {
                hallBackBusy = false;
                window.__fnExitPromptOpen = false;
            };
            try {
                if (typeof jqalert === 'function') {
                    jqalert({
                        content: '退出房间吗？',
                        yestext: '确定',
                        notext: '取消',
                        click_bg: false,
                        yesfn: leave,
                        nofn: cancel
                    });
                    // jqalert 正常情况下同步创建弹窗；若组件未挂载，立即使用
                    // 原生链接返回，避免移动端出现“点击无反应”。
                    if (!document.getElementById('jq-alert')) leave();
                    return;
                }
            } catch (err) {}
            if (window.confirm) {
                if (window.confirm('退出房间吗？')) leave();
                else cancel();
            } else {
                leave();
            }
        }
        window.fnHallBack = function (e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            goBack();
            return false;
        };
        $('.top-btn, #goback').off('.fnnav').on('touchend.fnnav click.fnnav', function (e) {
            if (e.type === 'click' && Date.now() - lastTouchAt < 700) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'touchend') lastTouchAt = Date.now();
            goBack();
            return false;
        });
    })();
    $('.game-box').on('click',function () {
        var gmid=$(this).data('gid');
        window.location.href='/action.php?do=room&game='+gmid;
        
        
    });

    // 大厅倒计时：本地每秒刷新 UI，服务器 5 秒同步一次（原先每秒 AJAX+整段重绘会卡 WebView）
    var hallTimers = {};
    var hallFp = {};
    var hallLastOpen = {};
    var hallPollBusy = false;

    function paintHallTime(gid) {
        var left = parseInt(hallTimers[gid], 10);
        if (isNaN(left)) return;
        var fp = parseInt(hallFp[gid], 10) || 0;
        $('#game-id-' + gid).find('.game-time').html(buildTime(left, fp));
    }

    function tickHallTimers() {
        Object.keys(hallTimers).forEach(function (gid) {
            if (hallTimers[gid] > 0) hallTimers[gid] -= 1;
            paintHallTime(gid);
        });
    }

    function syncHallTimers() {
        if (hallPollBusy) return;
        hallPollBusy = true;
        $.ajax({
            url: "/action.php?do=upop",
            method: 'get',
            dataType: 'json',
            data: {'gid': gimdIDS},
            success: function (res) {
                if (!res || !res.list) return;
                for (var i = 0; i < res.list.length; i++) {
                    var row = res.list[i];
                    if (!row.current_sn) {
                        // 开奖切换瞬间可能先返回 next_sn、稍后才补 current_sn；不能因此把下一期期号清空。
                        if (row.next_sn || row.next_term) {
                            $('#next_num_' + row.gameid).text(row.next_sn || row.next_term);
                        }
                        continue;
                    }
                    var gid = String(row.gameid);
                    hallTimers[gid] = parseInt(row.letf_time, 10) || 0;
                    hallFp[gid] = parseInt(row.fp_time, 10) || 0;
                    paintHallTime(gid);

                    var openKey = row.current_sn + '|' + row.open_num;
                    if (hallLastOpen[gid] !== openKey) {
                        hallLastOpen[gid] = openKey;
                        var numArr = String(row.open_num || '').split(',');
                        var box = $('#game-id-' + row.gameid);
                        var kind = box.attr('data-kind') || '';
                        var numHtml = '';
                        if (kind === 'pc28' && typeof window.pc28EquationHtml === 'function') {
                            numHtml = '<span class="sn-num">' + row.current_sn + '期</span>' + window.pc28EquationHtml(numArr, { light: false });
                        } else if (kind === 'lhc') {
                            numHtml = '<span class="sn-num">' + row.current_sn + '</span>';
                            var lhcBalls = [];
                            for (var j = 0; j < numArr.length; j++) {
                                if (numArr[j] === '') continue;
                                var ln = parseInt(numArr[j], 10);
                                if (isNaN(ln) || ln < 1) continue;
                                lhcBalls.push(ln);
                                if (lhcBalls.length >= 7) break;
                            }
                            while (lhcBalls.length < 7) lhcBalls.push(1);
                            for (var k = 0; k < 6; k++) {
                                var lpad = ('0' + lhcBalls[k]).slice(-2);
                                numHtml += '<span class="lhc-ball lhc-n' + lpad + '">' + lpad + '</span>';
                            }
                            numHtml += '<span class="lhc-plus">+</span>';
                            var ltpad = ('0' + lhcBalls[6]).slice(-2);
                            numHtml += '<span class="lhc-ball lhc-n' + ltpad + '">' + ltpad + '</span>';
                        } else {
                            numHtml = '<span class="sn-num">' + row.current_sn + '</span>';
                            for (var j = 0; j < numArr.length; j++) {
                                if (numArr[j] === '') continue;
                                var ballNo = parseInt(numArr[j], 10);
                                if (isNaN(ballNo) || ballNo < 0) continue;
                                numHtml += '<span class="n' + ballNo + '">' + ballNo + '</span>';
                            }
                        }
                        $('#current_num_' + row.gameid).html(numHtml);
                        $('#next_num_' + row.gameid).html(row.next_sn);
                    }
                }
            },
            complete: function () {
                hallPollBusy = false;
            }
        });
    }
    syncHallTimers();
    setInterval(tickHallTimers, 1000);
    setInterval(syncHallTimers, 5000);

    function buildTime(leftSec,fpSec) {
        var totalSec=parseInt(leftSec);
        if(isNaN(totalSec)||totalSec<=0) return '<b class="fping">封盘中</b>';
        var min  =   Math.floor(totalSec/60);
        var sec = totalSec%60;
        min=(min<10)?'0'+min:min+"";
        sec=(sec<10)?'0'+sec:sec+"";
        var lastStr='';
        lastStr+='<b>'+min[0]+'</b>';
        lastStr+='<b>'+min[1]+'</b>';
        lastStr+='<b>:</b>';
        lastStr+='<b>'+sec[0]+'</b>';
        lastStr+='<b>'+sec[1]+'</b>';
        return lastStr;
    }
</script>
