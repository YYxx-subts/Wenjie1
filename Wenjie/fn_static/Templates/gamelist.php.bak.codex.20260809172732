<style>
  html,body,html *,body *{-webkit-user-select:none!important;user-select:none!important;-webkit-touch-callout:none!important;-webkit-user-drag:none!important;}
  html,body{ -webkit-tap-highlight-color:transparent; }
  #hallGameList.is-reordering{touch-action:none;}
  #hallGameList .is-drag-placeholder{visibility:hidden!important;pointer-events:none!important;}
  #hallGameList .is-drag-source{opacity:.96;box-shadow:0 .2rem .45rem rgba(0,0,0,.35);}
</style>
<script>
(function () {
  // 大厅不提供文本选择、复制或系统长按菜单；点击、滚动和卡片排序仍由下方逻辑处理。
  function clearSelection() {
    try { var sel = window.getSelection && window.getSelection(); if (sel && sel.rangeCount) sel.removeAllRanges(); } catch (e) {}
  }
  ['contextmenu', 'selectstart', 'dragstart'].forEach(function (type) {
    document.addEventListener(type, function (e) { e.preventDefault(); e.stopPropagation(); clearSelection(); }, true);
  });
  ['copy', 'cut'].forEach(function (type) {
    document.addEventListener(type, function (e) { e.preventDefault(); e.stopPropagation(); clearSelection(); }, true);
  });
  document.addEventListener('selectionchange', clearSelection, true);
  document.addEventListener('touchstart', clearSelection, true);
  document.addEventListener('touchend', clearSelection, true);
  try { document.documentElement.style.webkitUserSelect = 'none'; } catch (e) {}
  try { document.documentElement.style.userSelect = 'none'; } catch (e) {}
  try { document.body.style.webkitTouchCallout = 'none'; } catch (e) {}

  var list = document.getElementById('hallGameList');
  if (!list) return;
  var orderKey = 'fn_hall_game_order_v2';
  var pressTimer = null, drag = null, raf = 0, pendingY = 0;
  var startX = 0, startY = 0, moved = false;

  function cards() {
    return Array.prototype.filter.call(list.querySelectorAll('.game-box'), function (el) {
      return !el.classList.contains('hall-cat-hidden') && !el.classList.contains('is-drag-placeholder');
    });
  }
  function readOrder() { try { return JSON.parse(localStorage.getItem(orderKey) || '[]'); } catch (e) { return []; } }
  function saveOrder() {
    var ids = cards().map(function (el) { return String(el.getAttribute('data-gid') || ''); }).filter(Boolean);
    try { localStorage.setItem(orderKey, JSON.stringify(ids)); } catch (e) {}
  }
  function applyOrder() {
    var order = readOrder(); if (!order.length) return;
    var byId = {};
    Array.prototype.forEach.call(list.querySelectorAll('.game-box[data-gid]'), function (el) { byId[String(el.getAttribute('data-gid'))] = el; });
    order.forEach(function (id) { if (byId[id]) list.appendChild(byId[id]); });
  }
  function clearTimer() { if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; } }
  function stopDoc() {
    document.removeEventListener('touchmove', move, true);
    document.removeEventListener('touchend', end, true);
    document.removeEventListener('touchcancel', cancel, true);
  }
  function reset(el) {
    if (!el) return;
    el.classList.remove('is-drag-source');
    ['position','left','top','width','height','margin','zIndex','pointerEvents','transform','transition'].forEach(function (p) { el.style[p] = ''; });
  }
  function finish(commit) {
    clearTimer(); stopDoc();
    if (!drag) return;
    var d = drag; drag = null;
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
    if (d.placeholder && d.placeholder.parentNode === list) {
      if (commit) {
        list.insertBefore(d.card, d.placeholder);
        saveOrder();
      } else if (d.originalNext && d.originalNext.parentNode === list) {
        list.insertBefore(d.card, d.originalNext);
      } else {
        list.appendChild(d.card);
      }
      d.placeholder.parentNode.removeChild(d.placeholder);
    }
    reset(d.card); list.classList.remove('is-reordering');
    setTimeout(function () { window.__fnHallDragging = false; }, 450);
  }
  function cancel() { finish(false); }
  function shiftOthers(mutator) {
    var before = {};
    cards().forEach(function (el) {
      before[String(el.getAttribute('data-gid') || '')] = el.getBoundingClientRect().top;
      el.style.transition = 'none';
      el.style.transform = '';
    });
    mutator();
    cards().forEach(function (el) {
      var id = String(el.getAttribute('data-gid') || '');
      var first = before[id];
      if (first == null) return;
      var delta = first - el.getBoundingClientRect().top;
      if (Math.abs(delta) < 1) return;
      el.style.transform = 'translate3d(0,' + delta + 'px,0)';
      requestAnimationFrame(function () {
        el.style.transition = 'transform .2s ease';
        el.style.transform = '';
      });
    });
  }
  function place(y) {
    if (!drag) return;
    var target = null;
    cards().some(function (el) {
      var r = el.getBoundingClientRect();
      if (y < r.top + r.height / 2) { target = el; return true; }
      return false;
    });
    if (target && drag.placeholder.nextSibling === target) return;
    if (!target && !drag.placeholder.nextSibling) return;
    shiftOthers(function () {
      if (target) list.insertBefore(drag.placeholder, target); else list.appendChild(drag.placeholder);
    });
  }
  function move(e) {
    if (!drag || !e.touches || !e.touches.length) return;
    if (e.cancelable) e.preventDefault();
    e.stopPropagation();
    pendingY = e.touches[0].clientY;
    if (raf) return;
    raf = requestAnimationFrame(function () {
      raf = 0;
      if (!drag) return;
      drag.card.style.top = (drag.top + pendingY - drag.startY) + 'px';
      place(pendingY);
    });
  }
  function end(e) {
    if (!drag) return;
    if (e.cancelable) e.preventDefault();
    e.stopPropagation();
    try { e.stopImmediatePropagation(); } catch (x) {}
    finish(true);
  }
  function begin(el, touch) {
    var r = el.getBoundingClientRect();
    var originalNext = el.nextSibling;
    var ph = document.createElement('div');
    ph.className = 'game-box is-drag-placeholder';
    ph.style.height = r.height + 'px'; ph.style.width = r.width + 'px'; ph.style.margin = getComputedStyle(el).margin;
    list.insertBefore(ph, el);
    drag = { card: el, placeholder: ph, originalNext: originalNext, startY: touch.clientY, top: r.top };
    document.body.appendChild(el);
    window.__fnHallDragging = true; list.classList.add('is-reordering');
    el.classList.add('is-drag-source');
    el.style.position = 'fixed'; el.style.left = r.left + 'px'; el.style.top = r.top + 'px';
    el.style.width = r.width + 'px'; el.style.height = r.height + 'px'; el.style.margin = '0';
    el.style.zIndex = '10000'; el.style.pointerEvents = 'none'; el.style.transform = 'scale(1.03)'; el.style.transition = 'none';
    document.addEventListener('touchmove', move, { capture: true, passive: false });
    document.addEventListener('touchend', end, { capture: true, passive: false });
    document.addEventListener('touchcancel', cancel, { capture: true, passive: false });
  }
  list.addEventListener('touchstart', function (e) {
    if (!e.touches || e.touches.length !== 1) return;
    var el = e.target.closest ? e.target.closest('.game-box') : null;
    if (!el || el.classList.contains('hall-cat-hidden')) return;
    var t = e.touches[0]; startX = t.clientX; startY = t.clientY; moved = false; clearTimer();
    pressTimer = setTimeout(function () { pressTimer = null; begin(el, t); }, 360);
  }, { passive: true });
  list.addEventListener('touchmove', function (e) {
    if (drag || !e.touches || !e.touches.length) return;
    var t = e.touches[0];
    if (Math.abs(t.clientX - startX) > 12 || Math.abs(t.clientY - startY) > 12) { moved = true; clearTimer(); }
  }, { passive: true });
  list.addEventListener('touchend', function () { if (!drag) clearTimer(); }, { passive: true });
  list.addEventListener('click', function (e) {
    if (window.__fnHallDragging || drag) { e.preventDefault(); e.stopPropagation(); try { e.stopImmediatePropagation(); } catch (x) {} }
  }, true);
  applyOrder();
})();
</script>
