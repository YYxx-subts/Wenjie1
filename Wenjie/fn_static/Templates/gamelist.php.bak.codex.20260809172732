<script type="text/javascript">
    var FEINIAO_ROOM_ID = <?php echo json_encode((string)($_SESSION['roomid'] ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    var FEINIAO_ROOM_NOTICE = <?php echo json_encode((string)$roomNotice, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;

    function normalizeBannerImage(value) {
        var src = String(value || '').trim();
        if (!src) return '';
        // 废弃的本地默认图（北京赛车PK10），一律忽略
        if (/home_banner_default\.(jpg|png|webp)/i.test(src)) return '';
        // 防御性过滤：轮播只接受服务器静态图片，禁止页面再次渲染 Base64。
        if (/^(data:image\/|blob:)/i.test(src)) return '';
        // 旧后台返回的静态资源域名不能直接用于 H5，统一切到实际静态域名。
        src = src.replace(/^https?:\/\/fnagent\.atmyx\.app(\/assets\/)/i, 'https://wjagent.atmyx.app$1');
        src = src.replace(/^https?:\/\/(?:wjagent|fnagent|fnh5)\.atmyx\.app(\/upload\/)/i, 'https://wjh5.atmyx.app$1');
        if (/^http:\/\//i.test(src)) src = 'https://' + src.slice(7);
        if (/^(data:image\/|https:\/\/|\/\/)/i.test(src)) return src;
        // 本站 H5 静态资源
        if (/^\/Style\//i.test(src)) return src;
        // H5 上传图片保留在 H5 站点，不要拼到后台域名
        if (/^\/upload\//i.test(src)) return 'https://wjh5.atmyx.app' + src;
        // 房主后台 /assets 图必须走 fnagent，不能当 H5 相对路径
        if (src.charAt(0) === '/') return 'https://wjagent.atmyx.app' + src;
        return 'https://wjagent.atmyx.app/' + src;
    }

    function filterBannerRows(payload) {
        var rows = [];
        if (payload && payload.data && Array.isArray(payload.data.banners)) rows = payload.data.banners;
        else if (payload && Array.isArray(payload.banners)) rows = payload.banners;
        else if (payload && payload.data && Array.isArray(payload.data)) rows = payload.data;
        else if (Array.isArray(payload)) rows = payload;
        return rows.filter(function (row) {
            var status = String(row && row.status == null ? 'enabled' : (row && row.status || '')).toLowerCase();
            var enabled = row && row.enabled !== false && ['disabled', 'disable', 'off', 'closed', 'close', '停用', '关闭'].indexOf(status) < 0;
            if (!enabled) return false;
            var image = normalizeBannerImage(row.image || row.imageUrl || row.url || row.src || row.path || row.banner);
            if (!image) return false;
            row.__normalizedImage = image;
            return true;
        }).sort(function (a, b) { return Number(a.sort || 0) - Number(b.sort || 0); });
    }

    function renderHomeBanners(payload) {
        var rows = filterBannerRows(payload);
        var box = $('#homeBanner').empty();
        // 无可用轮播：只留中性占位，绝不回退到已删的北京PK10图
        if (!rows.length) {
            box.removeClass('is-visible');
            return;
        }
        box.addClass('is-visible');
        var track = $('<div class="banner-track"></div>');
        rows.forEach(function (row, index) {
            var image = row.__normalizedImage || normalizeBannerImage(row.image || row.imageUrl || row.url || row.src || row.path || row.banner);
            if (!image) return;
            var slide = $('<a class="banner-slide" target="_blank" rel="noopener"></a>');
            if (row.link || row.href) slide.attr('href', row.link || row.href);
            else slide.attr('href', 'javascript:void(0)');
            var img = $('<img alt="" draggable="false" unselectable="on">');
            img.attr('decoding', 'async');
            if (index === 0) {
                img.attr('src', image).attr('fetchpriority', 'high').attr('loading', 'eager');
            } else {
                // 其他轮播先不写 src，避免 WebKit 在首屏同时建立多个图片请求。
                img.attr('data-src', image).attr('loading', 'lazy');
            }
            // 后台图片失效时移除当前轮播项，不能显示与后台无关的旧 fallback 图片。
            img.on('error', function () {
                var slideNode = this.parentNode;
                if (slideNode && slideNode.parentNode) slideNode.parentNode.removeChild(slideNode);
                if (!track.children().length) box.removeClass('is-visible');
            });
            slide.append(img);
            track.append(slide);
        });
        if (!track.children().length) {
            box.removeClass('is-visible');
            return;
        }
        box.append(track);

        var total = track.children().length;
        var current = 0;
        var timer = null;
        var dragging = false;
        var startX = 0;
        var startY = 0;
        var deltaX = 0;
        var locked = false;
        var ignoreClick = false;

        function ensureSlideImage(index) {
            var node = track.children().eq(index).find('img')[0];
            if (!node || node.getAttribute('src')) return;
            var pending = node.getAttribute('data-src');
            if (!pending) return;
            node.setAttribute('src', pending);
            node.removeAttribute('data-src');
        }

        function goTo(index, animate) {
            if (total <= 0) return;
            current = (index % total + total) % total;
            ensureSlideImage(current);
            if (animate === false) track.addClass('is-dragging');
            else track.removeClass('is-dragging');
            track.css('transform', 'translate3d(' + (-current * 100) + '%,0,0)');
            box.find('.banner-dot').removeClass('is-active').eq(current).addClass('is-active');
            if (animate === false) {
                // 强制回流后再恢复 transition，避免拖拽结束闪一下
                void track[0].offsetWidth;
                track.removeClass('is-dragging');
            }
        }

        function nextSlide() { goTo(current + 1, true); }
        function prevSlide() { goTo(current - 1, true); }

        function startAuto() {
            stopAuto();
            if (total < 2) return;
            timer = setInterval(nextSlide, 4000);
        }
        function stopAuto() {
            if (timer) { clearInterval(timer); timer = null; }
        }

        if (total >= 2) {
            var dots = $('<div class="banner-dots"></div>');
            for (var i = 0; i < total; i++) {
                (function (idx) {
                    dots.append(
                        $('<button type="button" class="banner-dot' + (idx === 0 ? ' is-active' : '') + '" aria-label="第' + (idx + 1) + '张"></button>')
                            .on('click', function (e) {
                                e.preventDefault();
                                e.stopPropagation();
                                goTo(idx, true);
                                startAuto();
                            })
                    );
                })(i);
            }
            box.append(dots);
        }

        goTo(0, false);
        startAuto();

        function onPointerDown(clientX, clientY) {
            if (total < 2) return;
            dragging = true;
            locked = false;
            ignoreClick = false;
            startX = clientX;
            startY = clientY;
            deltaX = 0;
            stopAuto();
            track.addClass('is-dragging');
        }
        function onPointerMove(clientX, clientY, evt) {
            if (!dragging) return;
            var dx = clientX - startX;
            var dy = clientY - startY;
            if (!locked) {
                if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
                if (Math.abs(dy) > Math.abs(dx)) {
                    dragging = false;
                    track.removeClass('is-dragging');
                    startAuto();
                    return;
                }
                locked = true;
            }
            if (evt && evt.cancelable) evt.preventDefault();
            deltaX = dx;
            var width = box.width() || 1;
            var percent = (-current * 100) + (deltaX / width * 100);
            track.css('transform', 'translate3d(' + percent + '%,0,0)');
        }
        function onPointerUp() {
            if (!dragging) return;
            dragging = false;
            track.removeClass('is-dragging');
            var width = box.width() || 1;
            var threshold = width * 0.18;
            if (Math.abs(deltaX) > 12) ignoreClick = true;
            if (deltaX <= -threshold) goTo(current + 1, true);
            else if (deltaX >= threshold) goTo(current - 1, true);
            else goTo(current, true);
            deltaX = 0;
            startAuto();
        }

        var el = box[0];
        el.addEventListener('touchstart', function (e) {
            if (!e.touches || !e.touches.length) return;
            onPointerDown(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });
        el.addEventListener('touchmove', function (e) {
            if (!e.touches || !e.touches.length) return;
            onPointerMove(e.touches[0].clientX, e.touches[0].clientY, e);
        }, { passive: false });
        el.addEventListener('touchend', onPointerUp);
        el.addEventListener('touchcancel', onPointerUp);

        el.addEventListener('mousedown', function (e) {
            if (e.button !== 0) return;
            onPointerDown(e.clientX, e.clientY);
        });
        window.addEventListener('mousemove', function (e) {
            onPointerMove(e.clientX, e.clientY, e);
        });
        window.addEventListener('mouseup', onPointerUp);

        track.on('click', 'a.banner-slide', function (e) {
            if (ignoreClick) {
                e.preventDefault();
                e.stopPropagation();
                ignoreClick = false;
                return false;
            }
            var href = $(this).attr('href') || '';
            if (!href || href.indexOf('javascript:') === 0) {
                e.preventDefault();
            }
        });
    }

    function loadHomeBanners() {
        // 轮播只认接口返回的启用图片；接口返回前保持空白，不读取旧 sessionStorage 或本地 fallback。
        renderHomeBanners(null);

        // 后台直连接口优先，避免同域 PHP 代理的冷启动/跨站 TLS 等待拖慢首屏；失败再回退代理。
        var request = {
            method: 'get',
            dataType: 'json',
            cache: false,
            data: { roomid: FEINIAO_ROOM_ID, _: Date.now() },
            timeout: 3500
        };
        $.ajax($.extend({}, request, {
            url: 'https://wjagent.atmyx.app/api/public/room-promos'
        }))
            .then(null, function () {
                return $.ajax($.extend({}, request, {
                    url: '/api_room_promos.php'
                }));
            })
            .done(function (payload) {
                renderHomeBanners(payload);
            });
    }
    // 让大厅骨架、首屏游戏卡片先完成绘制，再启动轮播接口请求。
    (function scheduleHomeBanners() {
        var start = function () { window.setTimeout(loadHomeBanners, 80); };
        if (window.requestAnimationFrame) window.requestAnimationFrame(start);
        else window.setTimeout(start, 80);
    })();

    // 游戏分类栏：只控制卡片显示，不改开奖数据和进入游戏地址。
    (function bindHallCategories() {
        var $nav = $('.hall-cat-nav');
        var $boxes = $('#hallGameList .game-box');
        if (!$nav.length || !$boxes.length) return;
        var sportIds = { '5': true, '6': true, '7': true, '10': true };
        var key = 'fn_hall_cat';
        function saved() {
            try { var c = localStorage.getItem(key); if (c === 'lottery' || c === 'sport') return c; } catch (e) {}
            return 'sport';
        }
        function apply(cat) {
            cat = cat === 'lottery' ? 'lottery' : 'sport';
            var visible = 0;
            $boxes.each(function () {
                var gameCat = sportIds[String($(this).data('gid'))] ? 'sport' : 'lottery';
                var show = gameCat === cat;
                $(this).toggleClass('hall-cat-hidden', !show).attr('data-cat', gameCat);
                if (show) visible++;
            });
            $nav.find('.hall-cat-btn').removeClass('is-on').attr('aria-pressed', 'false');
            $nav.find('.hall-cat-btn[data-cat="' + cat + '"]').addClass('is-on').attr('aria-pressed', 'true');
            try { localStorage.setItem(key, cat); } catch (e2) {}
            return visible;
        }
        window.__hallApplyCat = apply;
        apply(saved());
        $nav.off('.hallcat').on('click.hallcat', '.hall-cat-btn', function (e) {
            e.preventDefault();
            apply($(this).attr('data-cat'));
        });
    })();

