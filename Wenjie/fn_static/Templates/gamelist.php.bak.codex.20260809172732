                var audio = document.getElementById(id);
                if (!audio) return;
                try { audio.muted = false; audio.loop = true; } catch (e) {}
                var go = function(){
                  var p = audio.play();
                  if (p && p.catch) p.catch(function(){});
                };
                document.addEventListener("WeixinJSBridgeReady", go, false);
                document.addEventListener('YixinJSBridgeReady', go, false);
