<?php
include dirname(dirname(preg_replace('@\(.*\(.*$@', '', __FILE__))) . "/Public/config.php";
if (!isset($_SESSION['userid']) || $_SESSION['userid'] === '') {
    header('Location: /action.php?do=login');
    exit;
}
if (empty($_SESSION['roomid'])) {
    header('Location: /action.php?do=roomdoor');
    exit;
}

$roomid = $_SESSION['roomid'];
$uiFlags = function_exists('feiniao_ui_flags') ? feiniao_ui_flags($roomid) : array();
$noticeOn = !isset($uiFlags['noticeOn']) || !!$uiFlags['noticeOn'];
$roomNotice = '';
if ($noticeOn) {
    $roomNotice = trim((string) get_query_val('fn_setting', 'setting_kefu', array('roomid' => $roomid)));
    if ($roomNotice === '') {
        $roomNotice = "欢迎光临！\n上下分请联系在线客服。\n安全稳定 · 极速出款 · 专业服务";
    }
    $roomNotice = preg_replace('/<br\s*\/?>/i', "\n", $roomNotice);
    $roomNotice = strip_tags($roomNotice);
    $roomNotice = html_entity_decode($roomNotice, ENT_QUOTES, 'UTF-8');
}

$order = array(4, 3, 2, 1, 8, 9, 6, 7, 5, 10);

$games = array();
$defaultId = 0;
foreach ($order as $gid) {
    $row = get_query_vals('fn_lottery' . $gid, '*', array('roomid' => $roomid));
    if (!$row) {
        continue;
    }
    $isOpen = isset($row['gameopen']) ? (string)$row['gameopen'] : 'false';
    if ($isOpen === 'false') {
        continue;
    }
    $kind = getGameKind($gid);
    $odds = feiniao_intro_odds_from_lottery($gid, $row);
    $dbRules = isset($row['rules']) ? trim(strip_tags((string)$row['rules'])) : '';
    $games[] = array(
        'id' => (int)$gid,
        'code' => isset($gmidAli[$gid]) ? $gmidAli[$gid] : ('g' . $gid),
        'name' => getGameTxtName($gid),
        'kind' => $kind,
        'rulesText' => $dbRules,
        'odds' => $odds,
    );
    if ($defaultId === 0) {
        $defaultId = (int)$gid;
    }
}

$boot = array(
    'notice' => $roomNotice,
    'noticeOn' => $noticeOn,
    'games' => $games,
    'defaultId' => $defaultId,
);
$bootJson = json_encode($boot, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
if ($bootJson === false) {
    $bootJson = '{"notice":"","games":[],"defaultId":0}';
}
?>
