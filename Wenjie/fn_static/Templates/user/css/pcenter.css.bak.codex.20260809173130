/* 个人中心 — 保真：返回在标题左；头像在蓝卡内；钱包三项；上分同卡；宫格分离 */

.pc-body{
  margin: 0;
  background: #f2f3f5;
  color: #222;
  -webkit-tap-highlight-color: transparent;
  width: 100%;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;
  position: fixed;
  inset: 0;
}
.pc-page{
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: none;
  background: #f2f3f5;
  padding-bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
}

/* —— 顶栏（横向渐变蓝，与记录页一致） —— */
.pc-nav{
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: calc(max(env(safe-area-inset-top, 0px), 20px) + 6px) 12px 10px;
  background: #2f86e0;
  background-image: linear-gradient(90deg, #2b7adb 0%, #3aa6e8 52%, #4fc0f0 100%);
  box-sizing: border-box;
}
.pc-back{
  position: absolute;
  left: 8px;
  bottom: 4px;
  width: 40px;
  height: 40px;
  border: 0;
  background: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  outline: none;
  -webkit-tap-highlight-color: transparent;
  box-shadow: none;
}
.pc-back:focus,
.pc-back:active,
.pc-back:focus-visible{
  outline: none;
  border: 0;
  box-shadow: none;
}
.pc-back img{
  width: 16px;
  height: auto;
  filter: brightness(0) invert(1);
}
.pc-nav-title{
  margin: 0;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #fff;
  line-height: 40px;
  pointer-events: none;
}
.pc-nav-right{
  display: none;
}

/* —— 白卡片 —— */
.pc-card{
  background: #fff;
  border-radius: 1.4rem;
  margin: 1rem 1.2rem 0;
  overflow: hidden;
  box-sizing: border-box;
}
.pc-card-main{
  padding: 0;
}
.pc-card-menu{
  margin-top: 1rem;
  padding: 0;
}

/* —— 蓝区用户卡：对角渐变 + VIP水印 + 三项分隔 —— */
.pc-asset{
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1f6fd0 0%, #2f86e0 42%, #4fc0f0 100%);
  border-radius: 1.4rem 1.4rem 0 0;
  padding: 1.6rem 1.4rem 2.2rem;
  color: #fff;
  box-sizing: border-box;
}
.pc-asset-watermark{
  position: absolute;
  right: -0.2rem;
  top: 0.4rem;
  font-size: 7.2rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: rgba(255,255,255,0.12);
  line-height: 1;
  pointer-events: none;
  user-select: none;
  transform: rotate(-8deg);
}
.pc-profile{
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 1.2rem;
}
.pc-avatar{
  width: 5.4rem;
  height: 5.4rem;
  border-radius: 50%;
  overflow: hidden;
  background: #c8c8c8;
  flex-shrink: 0;
  border: 0.22rem solid rgba(255,255,255,0.85);
  box-shadow: 0 0 0 0.18rem rgba(180, 220, 255, 0.45);
  box-sizing: border-box;
}
.pc-avatar img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pc-profile-txt{
  min-width: 0;
  color: #fff;
}
.pc-name-row{
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
}
.pc-name{
  font-size: 1.8rem;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
}
.pc-vip-link{
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
}
.pc-vip{
  height: 3.4rem;
  width: auto;
  max-width: 11rem;
  display: block;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.18));
}
.pc-vip-art{
  display: inline-block;
  font-size: 1.45rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  line-height: 1;
  color: #fff4c8;
  text-shadow:
    0 1px 0 #8a5a12,
    0 2px 0 #6a4214,
    0 0 6px rgba(255, 210, 100, 0.55);
  font-style: italic;
}
.pc-vip-pill{ display: none; }
.pc-account{
  margin-top: 0.5rem;
  font-size: 1.3rem;
  color: rgba(255,255,255,0.95);
  line-height: 1.3;
  display: flex;
  align-items: center;
  gap: 0.55rem;
}
.pc-copy-btn{
  border: 0;
  background: rgba(255,255,255,0.22);
  color: #fff;
  font-size: 1.1rem;
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
  line-height: 1.4;
}
.pc-asset-row{
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 2rem;
}
.pc-asset-cell{
  flex: 1;
  text-align: center;
  min-width: 0;
  position: relative;
}
.pc-asset-cell + .pc-asset-cell::before{
  content: "";
  position: absolute;
  left: 0;
  top: 12%;
  bottom: 12%;
  width: 1px;
  background: rgba(255,255,255,0.35);
}
.pc-asset-cell-label{
  font-size: 1.25rem;
  opacity: 0.95;
}
.pc-asset-cell-val{
  margin-top: 0.45rem;
  font-size: 1.55rem;
  font-weight: 700;
  word-break: break-all;
}

/* —— 快捷三入口 —— */
.pc-quick{
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 1.6rem 0.8rem 1.5rem;
  background: #fff;
  box-sizing: border-box;
}
.pc-quick-item{
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  color: #333;
}
.pc-quick-ico{
  width: 5rem;
  height: 5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-quick-ico img{
  width: 5rem;
  height: 5rem;
  object-fit: contain;
  display: block;
}
.pc-quick-txt{
  margin-top: 0.65rem;
  font-size: 1.3rem;
  color: #333;
  line-height: 1.2;
}

/* —— 下方宫格 —— */
.pc-grid{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.pc-grid-item{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  min-height: 9.2rem;
  padding: 1.1rem 0.5rem;
  text-decoration: none;
  color: #333;
  box-sizing: border-box;
  border-right: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
}
.pc-grid-item:nth-child(3n){
  border-right: 0;
}
.pc-grid-item:nth-last-child(-n+3){
  border-bottom: 0;
}
.pc-grid-item img{
  width: 3.2rem;
  height: 3.2rem;
  object-fit: contain;
  display: block;
}
.pc-grid-item span{
  font-size: 1.3rem;
  color: #333;
  line-height: 1.2;
}

/* 自定义提示 */
.fn-toast[hidden]{display:none}
.fn-toast{
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  padding: 24px;
  box-sizing: border-box;
}
.fn-toast-card{
  min-width: 140px;
  max-width: 78vw;
  padding: 14px 18px;
  border-radius: 14px;
  background: linear-gradient(180deg, rgba(45, 120, 200, 0.95), rgba(30, 90, 160, 0.95));
  color: #fff;
  font-size: 14px;
  line-height: 1.45;
  text-align: center;
  box-shadow: 0 10px 28px rgba(20, 50, 90, 0.28);
  border: 1px solid rgba(255,255,255,0.12);
}
.fn-toast.is-err .fn-toast-card{
  background: linear-gradient(180deg, rgba(180, 70, 70, 0.95), rgba(140, 40, 40, 0.95));
}
