<script>
(function () {
  var MUSIC_KEY = 'fn_draw_music';
  var APP_VER = <?php echo json_encode($appVersion, JSON_UNESCAPED_UNICODE); ?>;
  var mask = document.getElementById('avMask');
  var fileAlbum = document.getElementById('fileAlbum');
  var fileCamera = document.getElementById('fileCamera');

  function toast(msg) {
    if (typeof jqtoast === 'function') jqtoast(msg);
    else alert(msg);
  }

  function musicOn() {
    if (window.FeiniaoBgMusic && typeof FeiniaoBgMusic.enabled === 'function') {
      return FeiniaoBgMusic.enabled();
    }
    try { return localStorage.getItem(MUSIC_KEY) !== '0'; } catch (e) { return true; }
  }
  function paintMusic() {
    var on = musicOn();
    var btn = document.getElementById('musicSwitch');
    btn.className = on ? 'si-switch on' : 'si-switch';
    btn.textContent = on ? '开启' : '关闭';
  }
  paintMusic();
  document.getElementById('musicSwitch').addEventListener('click', function (e) {
    e.stopPropagation();
    var next = !musicOn();
    if (window.FeiniaoBgMusic && typeof FeiniaoBgMusic.setEnabled === 'function') {
      FeiniaoBgMusic.setEnabled(next);
    } else {
      try { localStorage.setItem(MUSIC_KEY, next ? '1' : '0'); } catch (err) {}
    }
    paintMusic();
    toast(next ? '已开启游戏背景音乐' : '已关闭游戏背景音乐');
  });

  function showAvSheet() { mask.classList.add('show'); }
  function hideAvSheet() { mask.classList.remove('show'); }

  function uploadBlob(blob, filename) {
    if (!blob) return;
    var fd = new FormData();
    fd.append('file', blob, filename || ('avatar_' + Date.now() + '.jpg'));
    fd.append('field', 'img');
    toast('上传中...');
    $.ajax({
      url: '/action.php?do=uploader',
      type: 'post',
      data: fd,
      cache: false,
      processData: false,
      contentType: false,
      success: function (res) {
        try { res = typeof res === 'string' ? JSON.parse(res) : res; } catch (e) { res = { status: 0 }; }
        $('.jq-toast').remove();
        if (!res || (res.status != 1 && res.status != '1')) {
          toast((res && (res.error || res.msg)) || '上传失败');
          return;
        }
        if (res.header) {
          document.getElementById('avatarPreview').src = res.header + '?t=' + Date.now();
        }
        toast(res.msg || '上传成功');
      },
      error: function () {
        $('.jq-toast').remove();
        toast('网络错误，请重试');
      }
    });
  }

  function dataUrlToBlob(dataUrl) {
    var parts = dataUrl.split(',');
    var mime = (parts[0].match(/:(.*?);/) || [])[1] || 'image/jpeg';
    var bin = atob(parts[1]);
    var arr = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
    return new Blob([arr], { type: mime });
  }

  window.__fnOnAvatarPicked = function (dataUrl) {
    hideAvSheet();
    if (!dataUrl) return;
    try { uploadBlob(dataUrlToBlob(dataUrl), 'avatar.jpg'); }
    catch (e) { toast('图片处理失败'); }
  };

  function callNative(action) {
    // action: album | camera
    try {
      if (window.FnNative) {
        if (action === 'camera' && typeof FnNative.takePhoto === 'function') {
          FnNative.takePhoto();
          return true;
        }
        if (action === 'album' && typeof FnNative.pickAvatar === 'function') {
          FnNative.pickAvatar();
          return true;
        }
      }
    } catch (e) {}
    return false;
  }

  document.getElementById('avatarRow').addEventListener('click', function () {
    showAvSheet();
  });
  document.getElementById('avCancel').addEventListener('click', hideAvSheet);
  mask.addEventListener('click', function (e) {
    if (e.target === mask) hideAvSheet();
  });

  document.getElementById('avAlbum').addEventListener('click', function () {
    hideAvSheet();
    if (callNative('album')) return;
    try { fileAlbum.value = ''; } catch (e) {}
    fileAlbum.click();
  });
  document.getElementById('avCamera').addEventListener('click', function () {
    hideAvSheet();
    if (callNative('camera')) return;
    try { fileCamera.value = ''; } catch (e) {}
    fileCamera.click();
  });

  function onFileChange(input) {
    var f = input.files && input.files[0];
    if (f) uploadBlob(f, f.name || 'avatar.jpg');
  }
  fileAlbum.addEventListener('change', function () { onFileChange(this); });
  fileCamera.addEventListener('change', function () { onFileChange(this); });

  document.querySelectorAll('[data-href]').forEach(function (el) {
    el.addEventListener('click', function () {
      location.href = el.getAttribute('data-href');
    });
  });

  document.getElementById('checkVersion').addEventListener('click', function () {
    var ver = APP_VER;
    try {
      if (window.FnNative && typeof FnNative.getAppVersion === 'function') {
        ver = FnNative.getAppVersion() || ver;
      }
    } catch (e) {}
    document.getElementById('verText').textContent = '当前版本' + ver;
    toast('已是最新版本 ' + ver);
  });

  document.getElementById('clearCache').addEventListener('click', function () {
    try {
      var music = localStorage.getItem(MUSIC_KEY);
      localStorage.clear();
      sessionStorage.clear();
      if (music !== null) localStorage.setItem(MUSIC_KEY, music);
    } catch (e) {}
    try { if (window.FnNative && FnNative.clearCache) FnNative.clearCache(); } catch (e2) {}
    toast('缓存已清除');
  });

  document.getElementById('lineCheck').addEventListener('click', function () {
    var panel = document.getElementById('linePanel');
    panel.className = 'line-panel show';
    panel.innerHTML = '检测中...';
    var targets = [
      { name: '主线路', url: location.origin + '/action.php?do=login' },
      { name: '静态资源', url: location.origin + '/Style/plus.js?v=20260812pageload6' }
    ];
    var left = targets.length;
    var lines = [];
    targets.forEach(function (t, idx) {
      var t0 = Date.now();
      fetch(t.url, { method: 'GET', cache: 'no-store', credentials: 'same-origin' })
        .then(function () {
          lines[idx] = '<div class="line-ok">' + t.name + '：正常 ' + (Date.now() - t0) + 'ms</div>';
        })
        .catch(function () {
          lines[idx] = '<div class="line-bad">' + t.name + '：异常 ' + (Date.now() - t0) + 'ms</div>';
        })
        .then(function () {
          left -= 1;
          if (left <= 0) panel.innerHTML = lines.join('');
        });
    });
  });

  document.getElementById('logoutBtn').addEventListener('click', function () {
    if (!confirm('确定退出登录？')) return;
    location.href = '/action.php?do=logout';
  });
})();
</script>
