<script>
(function () {
  function toast(msg, type) {
    var box = document.getElementById('fnToast');
    if (!box) {
      box = document.createElement('div');
      box.id = 'fnToast';
      box.className = 'fn-toast';
      box.innerHTML = '<div class="fn-toast-card"><div class="fn-toast-msg"></div></div>';
      document.body.appendChild(box);
    }
    box.classList.remove('is-ok', 'is-err', 'is-info');
    box.classList.add(type === 'err' ? 'is-err' : 'is-ok');
    box.querySelector('.fn-toast-msg').textContent = msg || '';
    box.hidden = false;
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { box.hidden = true; }, 1600);
  }
  var btn = document.getElementById('pcCopyAccount');
  if (btn) {
    btn.addEventListener('click', function () {
      var text = btn.getAttribute('data-account') || '';
      if (!text) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          toast('账号已复制');
        }).catch(function () {
          fallbackCopy(text);
        });
      } else {
        fallbackCopy(text);
      }
    });
  }
  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.cssText = 'position:fixed;left:-9999px;top:0';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      toast('账号已复制');
    } catch (e) {
      toast('复制失败', 'err');
    }
    document.body.removeChild(ta);
  }

  // 首屏先用轻量缓存渲染；统计接口只负责随后校正数字，不阻塞个人中心打开。
  if (window.jQuery) {
    window.jQuery.ajax({
      url: '/Application/ajax_user_stats.php',
      dataType: 'json',
      cache: false,
      timeout: 1800
    }).done(function (data) {
      if (!data || data.success !== true) return;
      if (data.user_money != null) document.getElementById('pcMoneyVal').textContent = data.user_money;
      if (data.user_ls != null) document.getElementById('pcLiuVal').textContent = data.user_ls;
      if (data.user_earn != null) document.getElementById('pcYkVal').textContent = data.user_earn;
    });
  }

  // 个人中心从左侧边缘向右滑动时返回游戏大厅；只接管边缘水平手势，
  // 不影响页面上下滚动、表单输入和个人中心内部页面的正常点击。
  (function bindUserCenterSwipeBack() {
    var startX = 0;
    var startY = 0;
    var tracking = false;
    var navigating = false;

    document.addEventListener('touchstart', function (ev) {
      var t = ev.touches && ev.touches[0];
      tracking = !!(t && t.clientX <= 32);
      if (tracking) {
        startX = t.clientX;
        startY = t.clientY;
      }
    }, true);

    document.addEventListener('touchend', function (ev) {
      if (!tracking) return;
      tracking = false;
      var t = ev.changedTouches && ev.changedTouches[0];
      if (!t || navigating) return;
      var dx = t.clientX - startX;
      var dy = Math.abs(t.clientY - startY);
      if (dx > 72 && dy < 48) {
        navigating = true;
        window.location.replace('/action.php?do=gamelist');
      }
    }, true);
  })();
})();
</script>
