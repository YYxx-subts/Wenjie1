<script type="text/javascript">
    var lastSendInfo='';
    var lastChatFullAt=0;
    var pendingSendSeq=0;
    var lastChartID=0; window.lastChartID=0; window.__roomStopPoll=false;
    var showKeyBord=false;
    getNewChartInfo();
        function getNewChartInfo(){
        var delay = (window.ROOM_BOOT_CHAT && window.ROOM_BOOT_CHAT.length) ? 0 : ((typeof window.roomPollDelay === 'function') ? window.roomPollDelay() : 1200);
        setTimeout(function () {
            getChatInfo();
        }, delay)
    }
    window.getNewChartInfo = getNewChartInfo;
    function resolveRoomGame(){
        if(window.ROOM_GAME_CODE) return window.ROOM_GAME_CODE;
        if(window.ROOM_GAME_ID) return String(window.ROOM_GAME_ID);
        var m=(location.search||'').match(/[?&]game=(\d+)/);
        return m?m[1]:'';
    }
    function getChatInfo() {
        if(window.__roomChatPollBusy) return;
        if(window.__roomStopPoll) return;
        window.__roomChatPollBusy=true;
        var sendData={};
        lastChartID=parseInt(window.lastChartID,10)||parseInt(lastChartID,10)||0;
        // 首屏消息已由 room-ui 一次性渲染；首次轮询只取首屏之后的新消息，避免延迟补一批造成跳动。
        if(!lastChartID && window.ROOM_BOOT_CHAT && window.ROOM_BOOT_CHAT.length){
            for(var bootIdx=0; bootIdx<window.ROOM_BOOT_CHAT.length; bootIdx++){
                var bootId=parseInt(window.ROOM_BOOT_CHAT[bootIdx]&&window.ROOM_BOOT_CHAT[bootIdx].id,10)||0;
                if(bootId>lastChartID) lastChartID=bootId;
            }
        }
        window.lastChartID=lastChartID;
        sendData['type']=(lastChartID>0)?'update':'first';
        sendData['id']=lastChartID;
        sendData['game']=resolveRoomGame();
        var fullPoll=!lastChatFullAt || (Date.now()-lastChatFullAt>=3000);
        sendData['light']=fullPoll?'0':'1';
        if(!sendData['game']){ window.__roomChatPollBusy=false; getNewChartInfo(); return; }
        window.__roomLastPollSentMs = Date.now();
        $.ajax({
            url:'/Application/ajax_chat.php',
            method:'get',
            dataType:'json',
            data:sendData,
            success:function (res) {
                if(!res){ return; }
                if(res.success===false){
                    if(res.code==='SESSION_EXPIRED'){ window.__roomStopPoll=true; window.location.href='/action.php?do=login'; return; }
                    return;
                }
                var chatList=res.chat_list||[];
                var openInfo=res.open_info;
                if(typeof res.user_money!=='undefined'){ $('#user_money').html(res.user_money); }
                if(typeof res.user_earn!=='undefined'){ $('#user_earn').html(res.user_earn); }
                if(typeof res.user_ls!=='undefined'){ $('#user_ls').html(res.user_ls); }
                if(typeof res.user_hs!=='undefined'){ $('#user_hs').html(res.user_hs); lastChatFullAt=Date.now(); }
                if(chatList.length>0){
                    var chatHtml='';
                    for (i=0;i<chatList.length;i++){
                        var row=chatList[i];
                        var rid=parseInt(row['id'],10)||0;
                        if(rid>lastChartID){ lastChartID=rid; window.lastChartID=lastChartID; }
                        if(rid && document.getElementById('msg'+rid)) continue;
                        if(window.FeiniaoVipRoom&&window.FeiniaoVipRoom.bubbleHtml){
                            chatHtml+=window.FeiniaoVipRoom.bubbleHtml(row,res.username);
                                                }else{
                            var headerType=res.username!=row['nickname']?'left-header':'right-header';
                            var escChat=window.pendingChatEscape||function(v){
                              return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                            };
                            var safeHead=escChat(row.headimg||'');
                            var leftHeader=headerType=='left-header'?'<img src="'+safeHead+'">':'';
                            var rightHeader=headerType=='right-header'?'<img src="'+safeHead+'">':'';
                            var nickName='';
                            var safeNick=escChat(row.nickname||'');
                            var safeTime=escChat(row.addtime||'');
                            if(headerType=='left-header') nickName=safeNick+'  '+safeTime;
                            else nickName=safeTime+'  '+safeNick;
                            var safeContent=(window.FeiniaoVipRoom&&window.FeiniaoVipRoom.renderChatContent)
                              ? window.FeiniaoVipRoom.renderChatContent(row)
                              : escChat(row.content==null?'':String(row.content));
                            chatHtml+='<div id="msg'+escChat(row.id)+'" class="'+headerType+'">\n' +
                                '                <div class="lheader">'+leftHeader+'</div>\n' +
                                '                <div class="content-box">\n' +
                                '                    <div class="nick-name">'+nickName+'</div>\n' +
                                '                    <div class="content-info">\n' +
                                '                        <div class="chatnarr"></div>\n' +
                                '                        <div class="info-content">'+safeContent+'</div>\n' +
                                '                    </div>\n' +
                                '                </div>\n' +
                                '                <div class="rheader">'+rightHeader+'</div>\n' +
                                '            </div>';
                        }
                    }
                    try{ $(chatHtml).appendTo('#chat_list'); scrollToBt(); }catch(e){}
                }
                try{
                  if(openInfo){
                    showOpenInfo(openInfo);
                    if(typeof currentShow!=='undefined' && currentShow=='forecast-pc') popShow('forecast-pc',true);
                  }
                }catch(e){}
            },
            complete:function(){ window.__roomChatPollBusy=false; if(!window.__roomStopPoll) getNewChartInfo(); },
            error:function (xhr) {
                var body={};
                try{ body=JSON.parse(xhr.responseText||'{}'); }catch(e){}
                if (xhr.status === 401 && body.code==='SESSION_EXPIRED') {
                    window.location.href = '/action.php?do=login';
                    return;
                }
            }
        })
    }
    function showOpenInfo(row) {
        if(!row) return;
        window.__roomLeftSec=parseInt(row.letf_time,10)||0;
        window.__roomFpSec=parseInt(row.fp_time,10)||1;
        $('#next_sn').html(row.next_sn||row.current_sn||$('#next_sn').text()||'');
        $('#current_sn').html(row.current_sn||$('#current_sn').text()||'');
        var numArr=String(row.open_num||'').split(',');
        var numHtml='';
        if(typeof window.pc28EquationHtml==='function'){
            numHtml=window.pc28EquationHtml(numArr,{light:true});
        }else{
            for (i=0;i<numArr.length;i++){
                if(numArr[i]==='') continue;
                var ballNo=parseInt(numArr[i],10);
                if(isNaN(ballNo)||ballNo<0) continue;
                numHtml+='<span class="n'+ballNo+'">'+ballNo+'</span>';
            }
        }
        $('#current_num').html(numHtml);
        $('#left_time').html(buildTime(window.__roomLeftSec,window.__roomFpSec));
        $('#gyhs').html(row.gyh||'');
    }
    function buildTime(leftSec,fpSec) {
        var totalSec=parseInt(leftSec,10);
        if(isNaN(totalSec)||totalSec<0) totalSec=0;
        // 开奖中：不显示倒计时数字，只显示文案
        if(window.__roomWaitingDraw || (totalSec<=0 && !window.__roomSealed)){
            return '<b class="fping is-drawing">开奖中</b>';
        }
        // 封盘后：不显示倒计时数字，只显示封盘中
        if(window.__roomSealed){
            return '<b class="fping is-sealed">封盘中</b>';
        }
        var min  =   Math.floor(totalSec/60);
        var sec = totalSec%60;
        min=(min<10)?'0'+min:min+"";
        sec=(sec<10)?'0'+sec:sec+"";
        var lastStr='';
        lastStr+='<b>'+min[0]+'</b>';
        lastStr+='<b>'+min[1]+'</b>';
        lastStr+='<b>:</b>';
        lastStr+='<b>'+sec[0]+'</b>';
        lastStr+='<b>'+sec[1]+'</b>';
        return lastStr;
    }
    window.buildTime=buildTime;
    window.showOpenInfo=showOpenInfo;
    var __sendBusy=false;
    var __sendInFlight=0;
    function pendingChatEscape(value){
        return String(value==null?'':value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/\n/g,'<br>');
    }
    function appendPendingChat(content){
        var id='pending-chat-'+(++pendingSendSeq);
        var pendingHead=window.ROOM_BOOT_HEADIMG?'<img src="'+pendingChatEscape(window.ROOM_BOOT_HEADIMG)+'">':'';
        var html='<div id="'+id+'" class="right-header fn-chat-pending"><div class="lheader"></div><div class="content-box"><div class="nick-name">现在  '+pendingChatEscape(window.ROOM_BOOT_USER||'我')+'</div><div class="content-info"><div class="chatnarr"></div><div class="info-content">'+pendingChatEscape(content)+'</div></div></div><div class="rheader">'+pendingHead+'</div></div>';
        try{ $(html).appendTo('#chat_list'); scrollToBt(); }catch(e){}
        return id;
    }
    function finishPendingChat(pendingId, chatId, ok){
        var pending=$('#'+pendingId);
        if(!ok){ pending.remove(); return; }
        if(!pending.length) return;
        var cid=parseInt(chatId,10)||0;
        if(!cid || $('#msg'+cid).length){ pending.remove(); return; }
        pending.attr('id','msg'+cid).removeClass('fn-chat-pending').find('.chat-pending-status').remove();
    }
    function refreshChatNow(){
        try{ window.__roomChatPollBusy=false; getChatInfo(); }catch(e){}
    }
    function appendAnnounceList(list, myName){
        if(!list || !list.length) return;
        var chatHtml='';
        var me=myName||window.ROOM_BOOT_USER||'';
        for(var i=0;i<list.length;i++){
            var row=list[i]||{};
            var rid=parseInt(row.id,10)||0;
            if(rid && document.getElementById('msg'+rid)) continue;
            if(rid && rid>(parseInt(window.lastChartID,10)||0)){ lastChartID=rid; window.lastChartID=rid; }
            if(window.FeiniaoVipRoom&&window.FeiniaoVipRoom.bubbleHtml){
                chatHtml+=window.FeiniaoVipRoom.bubbleHtml(row, me);
                continue;
            }
            var escChat=window.pendingChatEscape||function(v){
              return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            };
            var headerType=(me && me===row.nickname)?'right-header':'left-header';
            var safeHead=escChat(row.headimg||'');
            var leftHeader=headerType=='left-header'?'<img src="'+safeHead+'">':'';
            var rightHeader=headerType=='right-header'?'<img src="'+safeHead+'">':'';
            var safeNick=escChat(row.nickname||'');
            var safeTime=escChat(row.addtime||'');
            var nickName=headerType=='left-header'?(safeNick+'  '+safeTime):(safeTime+'  '+safeNick);
            var safeContent=(window.FeiniaoVipRoom&&window.FeiniaoVipRoom.renderChatContent)
              ? window.FeiniaoVipRoom.renderChatContent(row)
              : (row.type==='S1' || row.type==='S2' || row.type==='S3' || /<[^>]+>/.test(String(row.content||''))
                  ? String(row.content||'')
                  : escChat(row.content==null?'':String(row.content)));
            chatHtml+='<div id="msg'+escChat(row.id)+'" class="'+headerType+'">'+
                '<div class="lheader">'+leftHeader+'</div>'+
                '<div class="content-box"><div class="nick-name">'+nickName+'</div>'+
                '<div class="content-info"><div class="chatnarr"></div><div class="info-content">'+safeContent+'</div></div></div>'+
                '<div class="rheader">'+rightHeader+'</div></div>';
        }
        if(!chatHtml) return;
        try{ $(chatHtml).appendTo('#chat_list'); scrollToBt(); }catch(e){}
    }
    function sendMsg(content) {
        if(content=="") return jqtoast('发送内容不能为空');
        if(typeof roomGuardSendBet==='function' && !roomGuardSendBet(content)) return;
        __sendInFlight++;
        __sendBusy=true;
        window.__sendBusy=true;
        var __sendStartedAt=Date.now();
        lastSendInfo=content;
        var pendingId=appendPendingChat(content);
        // 瞬间出报表：本地先插 @ + 注单卡，回包再换成正式消息
        var optimisticKey='';
        try{ if(window.appendOptimisticBetReport) optimisticKey=window.appendOptimisticBetReport(content)||''; }catch(e){}
        $('.keyb-input textarea').val('');
        try{ if(typeof checkInputValue==='function') checkInputValue(); }catch(e){}
        // 同一内容未确认成功前复用 bet_req_id，超时重试不会双扣
        var rid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID().replace(/\W/g,'') : (String(Date.now())+Math.random().toString(16).slice(2));
        var requestGame = resolveRoomGame();
        window.__lastBetReqId = rid;
        $.ajax({
            url: '/Application/ajax_chat.php?type=send',
            method: 'post',
            dataType: 'json',
            data:{
                'content':content,
                'game':requestGame,
                'bet_req_id':rid,
                // 封盘在途保护：点发送时的剩余秒/期号，服务端据此不因排队延迟误拒
                'bet_left_at_send': (typeof window.__roomLeftSec==='number'?window.__roomLeftSec:0),
                'bet_next_sn': (window.__roomNextSn||(document.getElementById('next_sn')&&document.getElementById('next_sn').textContent)||''),
                'bet_sent_at': Date.now()
            },
            success: function (res) {
                if(!res.success){
                    try{ if(window.clearOptimisticBetReport) window.clearOptimisticBetReport(optimisticKey); }catch(e){}
                    finishPendingChat(pendingId, 0, false);
                    // 业务明确拒绝才丢弃幂等键，便于用户改内容重发
                    if(typeof res.msg!="undefined") jqtoast(res.msg)
                    return;
                }
                finishPendingChat(pendingId, parseInt(res.chat_id,10)||0, true);
                // 正式回包替换乐观报表
                try{ if(window.clearOptimisticBetReport) window.clearOptimisticBetReport(optimisticKey); }catch(e){}
                appendAnnounceList(res.announce_list, res.username||window.ROOM_BOOT_USER);
                if(typeof res.user_money!=='undefined'){ try{ $('#user_money').html(res.user_money); }catch(e){} }
                if(window.console){ try{ console.log('[bet]', 'rtt='+(Date.now()-__sendStartedAt)+'ms', 'bet_ms='+res.bet_ms, 'total_ms='+res.total_ms, 'ann='+(res.announce_list||[]).length); }catch(e){} }
                if(!(res.announce_list&&res.announce_list.length)){ setTimeout(refreshChatNow, 1000); }
                else { setTimeout(refreshChatNow, 1500); }
            },
            error: function(){
                try{ if(window.clearOptimisticBetReport) window.clearOptimisticBetReport(optimisticKey); }catch(e){}
                finishPendingChat(pendingId, 0, false);
                jqtoast('发送失败，请重试（不会重复扣款）');
            },
            complete: function(){
                __sendInFlight=Math.max(0,__sendInFlight-1);
                __sendBusy=__sendInFlight>0;
                window.__sendBusy=__sendBusy;
            }
        });
    }
    
    // /* popup removed */
    function scrollToBt() {
        try{
          if(showKeyBord) $('#addSpan').show();
          else $('#addSpan').hide();
          var bt=$('#chatBt')[0];
          if(bt && bt.scrollIntoView) bt.scrollIntoView(false);
          if(showKeyBord){
              setTimeout(function () { $('#addSpan').hide(); },100)
          }
        }catch(e){}
    }
    window.scrollToBt=scrollToBt;
    // 点击输入栏直接出下注键盘；闲聊键才临时放开系统键盘
    var allowSystemKb=false;
    function enterChatInputMode(){
        hideKeyBordMain();
        $('#keyboard2').hide();
        allowSystemKb=true;
        var $ta = $('.keyb-input textarea');
        $ta.prop('readonly', false).removeAttr('readonly').attr('inputmode','text');
        setTimeout(function(){
            try { $ta[0].focus(); } catch(e) {}
        }, 30);
    }
    function enterBetKeyboardMode(){
        allowSystemKb=false;
        $('#keyboard2').hide();
        hideIframe();
        showKeyBord=true;
        $('.chat-content').css('padding-bottom','7.2rem');
        $('#keyboard1').show();
        var $ta=$('.keyb-input textarea');
        $ta.prop('readonly', true).attr('readonly', 'readonly').attr('inputmode','none');
        try { $ta[0].blur(); } catch(e) {}
        setTimeout(function(){ scrollToBt(); }, 300);
    }
    $('.keyb-input, #msg').on('click touchend', function(e){
        if(allowSystemKb) return;
        e.preventDefault();
        try { if(e.target && e.target.blur) e.target.blur(); } catch(err) {}
        if (!$('#keyboard1').is(':visible')) {
            enterBetKeyboardMode();
        }
    });
    $('#msg').on('focus', function(e){
        if(allowSystemKb) return;
        e.preventDefault();
        try { this.blur(); } catch(err) {}
        if (!$('#keyboard1').is(':visible')) {
            enterBetKeyboardMode();
        }
    });
</script>
<script type="text/javascript">
$('#switchkb').on('click',function () {
    $('#keyboard2').hide();
    hideIframe();
    if($('#keyboard1').is(":hidden")){
        enterBetKeyboardMode();
    }else{
        hideKeyBordMain();
        allowSystemKb=false;
        var $ta=$('.keyb-input textarea');
        $ta.prop('readonly', true).attr('readonly','readonly').attr('inputmode','none');
        try { $ta[0].blur(); } catch(e) {}
    }
});
$(function () {
    $('.chat-content .last-show').removeAttr('style');
    try{
      if(window.ROOM_BOOT_OPEN && typeof showOpenInfo==='function'){
        showOpenInfo(window.ROOM_BOOT_OPEN);
      }
    }catch(e){}
    // 默认锁定系统键盘，只走下注键盘
    allowSystemKb=false;
    $('#msg').prop('readonly', true).attr('readonly','readonly').attr('inputmode','none').attr('placeholder','');
    // 聊天轮询只由 getNewChartInfo 启动，避免双通道并发导致同一条消息插两次
});
$('.back').on('click',function () {
    // 优先复用历史栈中的大厅，避免返回时重新请求整页和重复计算。
    if (typeof window.feiniaoGo === 'function') {
        window.feiniaoGo('/action.php?do=gamelist');
    } else if (window.history && history.length > 1) {
        window.history.back();
    } else {
        window.location.href='/action.php?do=gamelist';
    }
});
function hideKeyBordMain() {
    showKeyBord=false;
    $('.chat-content').css('padding-bottom','1.5rem');
    $('#keyboard1').hide();
}
</script>
<script type="text/javascript">
    var currentInputKey='';
    var longPressTimer;
    var mouseDownType='ontouchstart' in document.documentElement?'touchstart':'mousedown';
    var mouseUpType='ontouchstart' in document.documentElement?'touchend':'mouseup';
    $('.last-show').on('click',function () {
        hideKeyBordMain();
    });
    $('.numbaord li,.fast-keyboard li,.pc28-quick li').on(mouseDownType,function (e) {
        console.log(mouseDownType,e);
        var oldValue=$('.keyb-input textarea').val();
        var newValue=oldValue;
        var $btn=$(this);
        var type;
        if($btn[0].hasAttribute('ktype')) type=$btn.attr('ktype');
        else if($btn.attr('data-key')!=null) type=$btn.attr('data-key');
        else type=$.trim($btn.text());
        if(type=='chat'){
            // 闲聊：收起下注键盘，临时改用系统键盘
            enterChatInputMode();
            currentInputKey='';
            return;
        }
        if(type=='del'){
            newValue=newValue.substr(0,newValue.length-1);
            currentInputKey=type;
        }else if(type=='sp'){
            newValue=newValue+" ";
        }else if(type=='发送'){
            sendMsg(newValue);
        }else if(type=='重复'){
            newValue=lastSendInfo;
        }
        else{
            newValue=newValue+type;
        }
        $('.keyb-input textarea').val(newValue);
        checkInputValue();
        startLongPress();

    }).on(mouseUpType,function (e) {
        currentInputKey='';
        clearInterval(longPressTimer);
    });
    $('.keyb-right').on('click',function () {
        var type=$(this).attr('type');
        var newValue=$('.keyb-input textarea').val();
        if(type=='send'){
            sendMsg(newValue);
        }else{
            hideIframe();
            $('#keyboard1').hide();
            if($('#keyboard2').is(":hidden")){
                $('#keyboard2').show();
                showKeyBord=true;
                $('.chat-content').css('padding-bottom','2.5rem');
                setTimeout(function(){
                    scrollToBt();
                },500);
            }
            else{
                showKeyBord=false;
                $('.chat-content').css('padding-bottom','1.5rem');
                $('#keyboard2').hide();
            }

        }
    });
    $('.keyb-input').on('input',function () {
        checkInputValue();
    });
    $(document).off('click.fnFastKeyboardUrl', '.fast-keyboard-url li[data-url]')
        .on('click.fnFastKeyboardUrl', '.fast-keyboard-url li[data-url]', function (event) {
            event.preventDefault();
            event.stopPropagation();
            var url = String($(this).attr('data-url') || '');
            if (url) window.location.assign(url);
        });
    $('.fast-keyboard-url li[data-txt]').on('click',function () {
        var txt=$(this).data('txt');
        sendMsg(txt);
    });
    function checkInputValue() {
        var val=$('.keyb-input textarea').val();
        if(val!==""){
            $('#sendbtn img').attr('src','/Style/newimg/send.png');
            $('#sendbtn').attr('type','send');
        }else{
            $('#sendbtn img').attr('src','/Style/newimg/add.png');
            $('#sendbtn').attr('type','add');
        }
        $('.keyb-input textarea')[0].scrollTop = $('.keyb-input textarea')[0].scrollHeight;
    }
    function startLongPress() {
        longPressTimer=setInterval(function () {
            if(currentInputKey=='del'){
                var oldValue=$('.keyb-input textarea').val();
                var newValue=oldValue.substr(0,oldValue.length-1);
                $('.keyb-input textarea').val(newValue);
            }
        },100);
    }
</script>
<script type="text/javascript">
    var currentShow='';
    function popShow(type,dontShow) {
        var dontShow=dontShow||false;
        $.ajax({
            url:'/action.php?do='+type,
            method:'get',
            dataType:'JSON',
            success:function (res) {
                if(dontShow) $('#iframeBox').html(res.html);
                else showIframe(res.html,type)
            }
        })
    }
    function showIframe(content,type) {
        if(currentShow==type){
            currentShow='';
            $('#iframeBox').hide();
        }else{
            currentShow=type;
            $('#iframeBox').html(content).show();
        }

    }
    function hideIframe() {
        currentShow='';
        $('#iframeBox').hide();
    }
    
</script>
