    function buildTime(leftSec,fpSec,waiting,sealed,maintenance) {
        // 服务端双重核验确认上游异常：首页只替换状态文字，不遮挡大厅。
        if (maintenance) {
            return '<b class="fping is-maintenance">维护中</b>';
        }
        // 服务端优先语义：sealed → 红色封盘中；drawing/processing → 开奖中；open+剩余秒 → 数字倒计时
        if (sealed && !waiting) {
            return '<b class="fping is-sealed">封盘中</b>';
        }
        if (waiting) {
            return '<b class="fping">开奖中</b>';
        }
        var totalSec=parseInt(leftSec,10);
        if(isNaN(totalSec)||totalSec<0) totalSec=0;
        if (totalSec <= 0) {
            return '<b class="fping is-sealed">封盘中</b>';
        }
        var min  =   Math.floor(totalSec/60);
        var sec = totalSec%60;
        min=(min<10)?'0'+min:min+"";
        sec=(sec<10)?'0'+sec:sec+"";
        var lastStr='';
        lastStr+='<b>'+min[0]+'</b>';
        lastStr+='<b>'+min[1]+'</b>';
        lastStr+='<b>:</b>';
        lastStr+='<b>'+sec[0]+'</b>';
        lastStr+='<b>'+sec[1]+'</b>';
        return lastStr;
    }
</script>
