    (function () {
        function applyHallCategory(cat) {
            cat = cat === 'lottery' ? 'lottery' : 'sport';
            var root = document.documentElement;
            root.setAttribute('data-hall-cat', cat);
            var boxes = document.querySelectorAll('#hallGameList .game-box');
            for (var i = 0; i < boxes.length; i++) {
                var visible = String(boxes[i].getAttribute('data-cat') || '') === cat;
                boxes[i].classList.toggle('is-cat-hidden', !visible);
                boxes[i].style.display = visible ? '' : 'none';
            }
            var buttons = document.querySelectorAll('.hall-cat-btn');
            for (var j = 0; j < buttons.length; j++) {
                var active = String(buttons[j].getAttribute('data-cat') || '') === cat;
                buttons[j].classList.toggle('is-on', active);
                buttons[j].setAttribute('aria-pressed', active ? 'true' : 'false');
            }
            try { localStorage.setItem('fn_hall_cat', cat); } catch (e) {}
        }
        window.__fnSetHallCategory = applyHallCategory;
        function handle(e) {
            var target = e.target;
            var button = target && target.closest ? target.closest('.hall-cat-btn') : null;
            if (!button) return;
            if (e.cancelable) e.preventDefault();
            e.stopPropagation();
            applyHallCategory(button.getAttribute('data-cat'));
        }
        document.addEventListener('touchend', handle, true);
        document.addEventListener('click', handle, true);
    })();
    </script>

