<script>
(function () {
  // 全页禁止长按系统菜单（复制/翻译/选中），输入框除外
  function fnHallIsEditable(el) {
    if (!el || !el.closest) return false;
    return !!el.closest('input, textarea, [contenteditable="true"]');
  }
  document.addEventListener('contextmenu', function (e) {
    if (fnHallIsEditable(e.target)) return;
    e.preventDefault();
  }, true);
  document.addEventListener('selectstart', function (e) {
    if (fnHallIsEditable(e.target)) return;
    e.preventDefault();
  }, true);
  document.addEventListener('dragstart', function (e) {
    if (fnHallIsEditable(e.target)) return;
    e.preventDefault();
  }, true);
  try { document.body.style.webkitTouchCallout = 'none'; } catch (err) {}
  try { document.documentElement.style.webkitUserSelect = 'none'; } catch (err) {}

  // 真正的卡片父级是 #hallGameList，不是外层 .gamelist
  var list = document.getElementById('hallGameList') || document.querySelector('.gamelist .last-show') || document.querySelector('.gamelist');
  var scroller = document.querySelector('.gamelist') || list;
  if (!list) return;

  var ORDER_KEY = 'fn_hall_game_order_v1';
  var LONG_MS = 360;
  var MOVE_CANCEL = 12;
  var pressTimer = null;
  var dragging = false;
  var startX = 0, startY = 0;
  var card = null;
  var placeholder = null;
  var cardH = 0;
  var originY = 0;
  var baseTop = 0;
  var baseLeft = 0;
  var dropIndex = -1;
  var raf = 0;
  var pendingY = 0;
  var docBound = false;
  var homeParent = null;
  var homeNext = null;

  function cat() {
    return document.documentElement.getAttribute('data-hall-cat') || 'lottery';
  }
  function readMap() {
    try { return JSON.parse(localStorage.getItem(ORDER_KEY) || '{}') || {}; } catch (e) { return {}; }
  }
  function writeMap(m) {
    try { localStorage.setItem(ORDER_KEY, JSON.stringify(m)); } catch (e) {}
  }
  function itemCards() {
    var out = [];
    var kids = list.children;
    for (var i = 0; i < kids.length; i++) {
      var el = kids[i];
      if (!el.classList || !el.classList.contains('game-box')) continue;
      if (el.classList.contains('is-cat-hidden') || el.classList.contains('is-drag-placeholder')) continue;
      out.push(el);
    }
    return out;
  }
  function applyOrder() {
    var order = readMap()[cat()];
    if (!order || !order.length) return;
    var map = {};
    Array.prototype.forEach.call(list.querySelectorAll('.game-box[data-gid]'), function (el) {
      var id = String(el.getAttribute('data-gid') || '');
      if (id) map[id] = el;
    });
    for (var i = 0; i < order.length; i++) {
      var el = map[String(order[i])];
      if (el) list.appendChild(el);
    }
  }
  function saveOrder() {
    var ids = [];
    var cards = itemCards();
    for (var i = 0; i < cards.length; i++) {
      var id = String(cards[i].getAttribute('data-gid') || '');
      if (id) ids.push(id);
    }
    if (!ids.length) return;
    var m = readMap();
    m[cat()] = ids;
    writeMap(m);
  }
  applyOrder();
  var nav = document.querySelector('.hall-cat-nav');
  if (nav) {
    nav.addEventListener('click', function () {
      setTimeout(applyOrder, 30);
    }, false);
  }

  function clearPress() {
    if (pressTimer) { clearTimeout(pressTimer); pressTimer = null; }
  }

  function clearShifts() {
    var kids = list.querySelectorAll('.game-box');
    for (var i = 0; i < kids.length; i++) {
      kids[i].classList.remove('is-shifting');
      kids[i].style.transition = '';
      kids[i].style.transform = '';
    }
  }

  function unbindDoc() {
    if (!docBound) return;
    document.removeEventListener('touchmove', onDocMove, true);
    document.removeEventListener('touchend', onDocEnd, true);
    document.removeEventListener('touchcancel', onDocCancel, true);
    docBound = false;
  }
  function bindDoc() {
    if (docBound) return;
    document.addEventListener('touchmove', onDocMove, { capture: true, passive: false });
    document.addEventListener('touchend', onDocEnd, { capture: true, passive: false });
    document.addEventListener('touchcancel', onDocCancel, { capture: true, passive: false });
    docBound = true;
  }

  function resetCardStyles(el) {
    if (!el) return;
    el.classList.remove('is-drag-source');
    el.style.position = '';
    el.style.left = '';
    el.style.top = '';
    el.style.width = '';
    el.style.height = '';
    el.style.margin = '';
    el.style.zIndex = '';
    el.style.opacity = '';
    el.style.pointerEvents = '';
    el.style.transform = '';
    el.style.transition = '';
    el.style.boxShadow = '';
  }

  function putCardBack(el, beforeNode) {
    if (!el) return;
    resetCardStyles(el);
    if (beforeNode && beforeNode.parentNode === list) {
      list.insertBefore(el, beforeNode);
    } else if (homeNext && homeNext.parentNode === list) {
      list.insertBefore(el, homeNext);
    } else {
      list.appendChild(el);
    }
  }

  function cleanupVisual(keepCardInPlace) {
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
    clearShifts();
    if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
    placeholder = null;
    if (card && !keepCardInPlace) {
      // 仅在未提交时把卡放回原位；提交时已经 insert 好了
      if (!list.contains(card)) putCardBack(card, null);
      else resetCardStyles(card);
    } else if (card) {
      resetCardStyles(card);
    }
    scroller.classList.remove('is-reordering');
    list.classList.remove('is-reordering');
    dropIndex = -1;
    homeParent = null;
    homeNext = null;
  }

  function endDrag(commit) {
    clearPress();
    unbindDoc();
    if (!dragging) {
      cleanupVisual(false);
      card = null;
      window.__fnHallDragging = false;
      return;
    }
    dragging = false;
    window.__fnHallDragging = true;

    if (commit && card && placeholder && placeholder.parentNode === list) {
      list.insertBefore(card, placeholder);
      resetCardStyles(card);
      if (placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
      placeholder = null;
      saveOrder();
      clearShifts();
      scroller.classList.remove('is-reordering');
      list.classList.remove('is-reordering');
      dropIndex = -1;
      homeParent = null;
      homeNext = null;
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
    } else {
      cleanupVisual(false);
    }

    card = null;
    setTimeout(function () { window.__fnHallDragging = false; }, 450);
  }

  function startDrag(el, y) {
    if (dragging || !el || !list.contains(el)) return;
    try { if (navigator.vibrate) navigator.vibrate(10); } catch (e) {}

    dragging = true;
    window.__fnHallDragging = true;
    card = el;
    cardH = el.offsetHeight || 80;
    var rect = el.getBoundingClientRect();
    originY = y;
    baseTop = rect.top;
    baseLeft = rect.left;
    pendingY = y;
    dropIndex = -1;
    homeParent = el.parentNode;
    homeNext = el.nextSibling;

    scroller.classList.add('is-reordering');
    list.classList.add('is-reordering');

    placeholder = document.createElement('div');
    placeholder.className = 'game-box is-drag-placeholder';
    placeholder.style.height = cardH + 'px';
    placeholder.style.width = rect.width + 'px';
    placeholder.style.margin = window.getComputedStyle(el).margin;
    list.insertBefore(placeholder, el);

    // 把真卡挂到 body 跟手；列表里只留占位符（绝不 remove 丢卡）
    el.classList.add('is-drag-source');
    el.style.position = 'fixed';
    el.style.left = rect.left + 'px';
    el.style.top = rect.top + 'px';
    el.style.width = rect.width + 'px';
    el.style.height = cardH + 'px';
    el.style.margin = '0';
    el.style.zIndex = '10000';
    el.style.opacity = '0.97';
    el.style.pointerEvents = 'none';
    el.style.transform = 'scale(1.04)';
    el.style.transition = 'none';
    el.style.boxShadow = '0 0.2rem 0.45rem rgba(0,0,0,.35)';
    document.body.appendChild(el);

    bindDoc();
  }

  function indexFromY(y) {
    var cards = itemCards();
    for (var i = 0; i < cards.length; i++) {
      var r = cards[i].getBoundingClientRect();
      if (y < r.top + r.height * 0.5) return i;
    }
    return cards.length;
  }

  // FLIP：占位符移动前后，其它卡平滑滑到新位置（桌面图标让位感）
  function flipShift(mutator) {
    var cards = itemCards();
    var first = {};
    for (var i = 0; i < cards.length; i++) {
      first[cards[i].getAttribute('data-gid') || i] = cards[i].getBoundingClientRect().top;
    }
    mutator();
    cards = itemCards();
    for (var j = 0; j < cards.length; j++) {
      var el = cards[j];
      var key = el.getAttribute('data-gid') || j;
      if (first[key] == null) continue;
      var dy = first[key] - el.getBoundingClientRect().top;
      if (Math.abs(dy) < 1) continue;
      el.classList.add('is-shifting');
      el.style.transition = 'none';
      el.style.transform = 'translate3d(0,' + dy + 'px,0)';
      (function (node) {
        void node.offsetWidth;
        node.style.transition = 'transform .2s ease';
        node.style.transform = '';
        var done = function () {
          node.style.transition = '';
          node.classList.remove('is-shifting');
          node.removeEventListener('transitionend', done);
        };
        node.addEventListener('transitionend', done);
      })(el);
    }
  }

  function placePlaceholderByIndex(idx) {
    if (idx === dropIndex) return;
    var cards = itemCards();
    var before = (idx < cards.length) ? cards[idx] : null;
    if (before) {
      if (placeholder.nextSibling === before) { dropIndex = idx; return; }
    } else if (!placeholder.nextSibling) {
      dropIndex = idx; return;
    }
    dropIndex = idx;
    flipShift(function () {
      if (before) list.insertBefore(placeholder, before);
      else list.appendChild(placeholder);
    });
  }

  function doMove(y) {
    if (!dragging || !card || !placeholder) return;
    card.style.top = (baseTop + (y - originY)) + 'px';
    card.style.left = baseLeft + 'px';
    placePlaceholderByIndex(indexFromY(y));

    var lr = scroller.getBoundingClientRect();
    var edge = 48;
    if (y < lr.top + edge) {
      scroller.scrollTop -= 14;
      dropIndex = -1;
      placePlaceholderByIndex(indexFromY(y));
    } else if (y > lr.bottom - edge) {
      scroller.scrollTop += 14;
      dropIndex = -1;
      placePlaceholderByIndex(indexFromY(y));
    }
  }

  function onMove(y) {
    pendingY = y;
    if (raf) return;
    raf = requestAnimationFrame(function () {
      raf = 0;
      doMove(pendingY);
    });
  }

  function onDocMove(e) {
    if (!dragging) return;
    if (!e.touches || !e.touches.length) return;
    if (e.cancelable) e.preventDefault();
    e.stopPropagation();
    onMove(e.touches[0].clientY);
  }
  function onDocEnd(e) {
    if (!dragging) return;
    if (e.cancelable) e.preventDefault();
    e.stopPropagation();
    try { e.stopImmediatePropagation(); } catch (err) {}
    endDrag(true);
  }
  function onDocCancel() {
    if (!dragging) return;
    endDrag(false);
  }

  list.addEventListener('touchstart', function (e) {
    if (!e.touches || e.touches.length !== 1) return;
    var el = e.target && e.target.closest ? e.target.closest('.game-box') : null;
    if (!el || !list.contains(el) || el.classList.contains('is-cat-hidden')) return;
    if (el.classList.contains('is-drag-placeholder')) return;
    var t = e.touches[0];
    startX = t.clientX;
    startY = t.clientY;
    clearPress();
    var target = el;
    var sy = t.clientY;
    pressTimer = setTimeout(function () {
      pressTimer = null;
      startDrag(target, sy);
      onMove(sy);
    }, LONG_MS);
  }, { passive: true });

  list.addEventListener('touchmove', function (e) {
    if (dragging) return;
    if (!e.touches || !e.touches.length) return;
    var t = e.touches[0];
    if (Math.abs(t.clientX - startX) > MOVE_CANCEL || Math.abs(t.clientY - startY) > MOVE_CANCEL) {
      clearPress();
    }
  }, { passive: true });

  list.addEventListener('touchend', function () { if (pressTimer) clearPress(); }, { passive: true });
  list.addEventListener('touchcancel', function () { if (pressTimer) clearPress(); }, { passive: true });

  list.addEventListener('touchend', function (e) {
    if (window.__fnHallDragging || dragging) {
      e.preventDefault();
      e.stopPropagation();
      try { e.stopImmediatePropagation(); } catch (err) {}
    }
  }, true);
  list.addEventListener('click', function (e) {
    if (window.__fnHallDragging || dragging) {
      e.preventDefault();
      e.stopPropagation();
      try { e.stopImmediatePropagation(); } catch (err) {}
    }
  }, true);
})();
</script>

<script type="text/javascript">
// 最终分类保护：开奖轮询、卡片重绘等后续逻辑不得把两类游戏重新混在一起。
(function () {
    var list = document.getElementById('hallGameList');
    if (!list || !window.MutationObserver) return;
    var busy = false;
    function enforce() {
        if (busy) return;
        busy = true;
        var root = document.documentElement;
        var cat = root.getAttribute('data-hall-cat') || 'sport';
        if (cat !== 'sport' && cat !== 'lottery') cat = 'sport';
        var boxes = list.querySelectorAll('.game-box[data-cat]');
        for (var i = 0; i < boxes.length; i++) {
            var visible = boxes[i].getAttribute('data-cat') === cat;
            boxes[i].classList.toggle('is-cat-hidden', !visible);
            boxes[i].style.setProperty('display', visible ? '' : 'none', 'important');
        }
        busy = false;
    }
    window.__fnHallCategoryGuard = new MutationObserver(function () { enforce(); });
    window.__fnHallCategoryGuard.observe(list, {subtree:true, childList:true, attributes:true, attributeFilter:['class','style','data-cat']});
    enforce();
})();
</script>

