<script type="text/javascript">
    var FEINIAO_USER_ID = <?php echo json_encode((string)($_SESSION['userid'] ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    var FEINIAO_ROOM_ID = <?php echo json_encode((string)($_SESSION['roomid'] ?? ''), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    var FEINIAO_ROOM_NOTICE = <?php echo json_encode((string)$roomNotice, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    // 轮播配置以后台实时结果为准，不再持久化到 WebView storage。
    // 否则后台删除图片后，旧 session/localStorage 会在网络慢或失败时把它重新画出来。
    var FALLBACK_BANNER_IMAGE = '/Style/newimg/home_banner_preload.png?v=20260812preload2';
    var FALLBACK_BANNER_PAYLOAD = {
        data: { banners: [{ id: 'local-fallback', status: 'enabled', sort: 1,
            image: FALLBACK_BANNER_IMAGE, link: '' }] }
    };

    function purgeLegacyBannerCaches() {
        ['sessionStorage', 'localStorage'].forEach(function (storageName) {
            try {
                var storage = window[storageName];
                var keys = [];
                for (var i = 0; i < storage.length; i++) {
                    var key = storage.key(i);
                    // 只清理旧版持久化键，保留当前 WebView 会话缓存 v2，
                    // 否则每次回大厅都会先删掉刚保存的轮播数据。
                    if (/^fn_home_banners_(?!cache_v2_)/i.test(String(key || ''))) keys.push(key);
                }
                keys.forEach(function (key) { storage.removeItem(key); });
            } catch (e) {}
        });
    }
    purgeLegacyBannerCaches();

    // 大厅首屏后台预热 VIP 页面会用到的等级图标，进入 VIP 时直接命中 WebView 缓存。
    (function preloadVipAssets() {
        var base = '/Templates/user/images/vip/';
        ['0-9.png','10-19.png','20-29.png','30-39.png','40-49.png','50-59.png','60-69.png','70-79.png','80.png'].forEach(function (name) {
            var img = new Image();
            img.decoding = 'async';
            img.src = base + name + '?v=20260812vip-preload1';
        });
    })();

    function normalizeBannerImage(value) {
        var src = String(value || '').trim();
        if (!src) return '';
        // 两张已废弃的历史兜底图一律拒绝；即使旧接口数据再次返回也不能复活。
        if (/(home_banner_default|carousel-official-crop)\.(jpg|png|webp)/i.test(src)) return '';
        // 后台接口历史上会返回 wjagent 的 /upload 地址，但图片实际存放在 H5 站点。
        // 后台域名会返回后台入口 HTML，WKWebView 因此显示为轮播空白。
        src = src.replace(/^https?:\/\/wjagent\.atmyx\.app(\/upload\/)/i, 'https://wjh5.atmyx.app$1');
        if (/^\/upload\//i.test(src)) return 'https://wjh5.atmyx.app' + src;
        // 历史版本曾缓存整张 data:image；后台删除后仍可永久复活，因此不再接受。
        if (/^data:image\//i.test(src)) return '';
        if (/^(https?:\/\/|\/\/)/i.test(src)) return src;
        // 本站 H5 静态资源
        if (/^\/Style\//i.test(src)) return src;
        // /upload 是轮播图的 H5 静态目录；其余旧后台 /assets 仍走后台域名。
        if (src.charAt(0) === '/') return 'https://wjagent.atmyx.app' + src;
        return 'https://wjagent.atmyx.app/' + src;
    }

    function filterBannerRows(payload) {
        var rows = payload && payload.data && Array.isArray(payload.data.banners) ? payload.data.banners : [];
        return rows.filter(function (row) {
            var status = String(row && row.status == null ? 'enabled' : (row && row.status || '')).toLowerCase();
            var enabled = row && row.enabled !== false && ['disabled', 'disable', 'off', 'closed', 'close', '停用', '关闭'].indexOf(status) < 0;
            if (!enabled) return false;
            var image = normalizeBannerImage(row.image || row.imageUrl || row.url);
            if (!image) return false;
            row.__normalizedImage = image;
            return true;
        }).sort(function (a, b) { return Number(a.sort || 0) - Number(b.sort || 0); });
    }

    function renderHomeBanners(payload) {
        var rows = filterBannerRows(payload);
        var box = $('#homeBanner').empty();
        // 图片解码完成前以及任何图片加载失败时，底层始终是指定预加载图。
        box.css({
            'background-image': 'url("' + FALLBACK_BANNER_IMAGE + '")',
            'background-size': 'cover',
            'background-position': 'center'
        });
        if (!rows.length) {
            box.addClass('is-visible');
            return;
        }
        box.addClass('is-visible');
        var track = $('<div class="banner-track"></div>');
        rows.forEach(function (row, index) {
            var image = row.__normalizedImage || normalizeBannerImage(row.image || row.imageUrl || row.url);
            if (!image) return;
            var slide = $('<a class="banner-slide" target="_blank" rel="noopener"></a>');
            if (row.link || row.href) slide.attr('href', row.link || row.href);
            else slide.attr('href', 'javascript:void(0)');
            var img = $('<img alt="" draggable="false" unselectable="on">').attr('src', bustBannerUrl(image, row));
            img.on('error', function () {
                if (this.getAttribute('data-fallback-applied') === '1') return;
                this.setAttribute('data-fallback-applied', '1');
                this.src = FALLBACK_BANNER_IMAGE;
            });
            // 第一张轮播是首页最大可见素材：立即拉取且提高优先级；其余保持正常解码。
            img.attr('decoding', 'async');
            if (index === 0) img.attr('fetchpriority', 'high').attr('loading', 'eager');
            else img.attr('loading', 'lazy');
            slide.append(img);
            track.append(slide);
        });
        if (!track.children().length) {
            box.removeClass('is-visible');
            return;
        }
        box.append(track);

        var realTotal = track.children().length;
        var loop = realTotal >= 2;
        // 无限循环：首尾各克隆一张，结构 [末克隆][0..n-1][首克隆]
        if (loop) {
            var $first = track.children().first().clone(true, true);
            var $last = track.children().last().clone(true, true);
            $first.attr('data-clone', 'first');
            $last.attr('data-clone', 'last');
            track.prepend($last);
            track.append($first);
        }
        var total = track.children().length; // 含克隆
        // track 下标：loop 时 1..(realTotal) 为真实图，0/末为克隆
        var current = loop ? 1 : 0;
        var timer = null;
        var dragging = false;
        var startX = 0;
        var startY = 0;
        var deltaX = 0;
        var locked = false;
        var ignoreClick = false;
        var jumping = false;

        function realIndex(trackIdx) {
            if (!loop) return trackIdx;
            if (trackIdx <= 0) return realTotal - 1;
            if (trackIdx >= realTotal + 1) return 0;
            return trackIdx - 1;
        }
        function updateDots() {
            box.find('.banner-dot').removeClass('is-active').eq(realIndex(current)).addClass('is-active');
        }
        function setTransform(trackIdx, animate) {
            if (animate === false) track.addClass('is-dragging');
            else track.removeClass('is-dragging');
            track.css('transform', 'translate3d(' + (-trackIdx * 100) + '%,0,0)');
            if (animate === false) {
                void track[0].offsetWidth;
                track.removeClass('is-dragging');
            }
        }
        function normalizeAfterTransition() {
            if (!loop || jumping) return;
            if (current === 0) {
                // 落到「末克隆」→ 无动画跳到真实最后一张
                jumping = true;
                current = realTotal;
                setTransform(current, false);
                jumping = false;
            } else if (current === realTotal + 1) {
                // 落到「首克隆」→ 无动画跳到真实第一张
                jumping = true;
                current = 1;
                setTransform(current, false);
                jumping = false;
            }
            updateDots();
        }

        function goTo(trackIdx, animate) {
            if (total <= 0) return;
            if (!loop) {
                current = (trackIdx % total + total) % total;
                setTransform(current, animate);
                updateDots();
                return;
            }
            current = trackIdx;
            setTransform(current, animate);
            updateDots();
            if (animate === false) {
                normalizeAfterTransition();
            }
        }

        function nextSlide() { goTo(current + 1, true); }
        function prevSlide() { goTo(current - 1, true); }

        function startAuto() {
            stopAuto();
            if (realTotal < 2) return;
            timer = setInterval(nextSlide, 4000);
        }
        function stopAuto() {
